---
// 사무실 직원 한 명: 책상 앞 캐릭터 + 상태별 움직임
// kind: zero(AI 부서, 제로 가족) / are(사업 부서, 아르 가족 양) / bull(주식 부서, 불리 가족 황소)
// acc: 직원마다 다른 소품 (glasses heart beret pencil tie bowtie cap ribbon headset helmet crown)
// status: working(타이핑) / waiting(커피 들고 기다림) / done(기지개 + ✓)
const { kind = 'zero', acc = '', status = 'done', prop = '' } = Astro.props;
const BODY = { zero: '#F2D53C', are: '#9cc3f0', bull: '#a78bfa', human: '#3b4150' };
const ey = kind === 'bull' ? 27 : 29;
// 얼굴 위치와 색 (눈 x, 눈 y, 눈 크기, 눈동자 색, 눈썹/감은 눈 색, 입 y, 입 색)
const F = {
  zero: { xs: [34.6, 41.4], ey, er: [1.6, 2.5], pc: '#F2D53C', ec: '#F2D53C', my: 34.8, mc: '#F2D53C' },
  are: { xs: [34.3, 41.7], ey, er: [1.4, 1.4], pc: '#4A4A57', ec: '#4A4A57', my: 34, mc: '#4A4A57' },
  human: { xs: [34.6, 41.4], ey: 30, er: [1.2, 1.5], pc: '#25282d', ec: '#25282d', my: 35, mc: '#9a3412' },
  bull: { xs: [33.5, 42.5], ey, er: [1.1, 1.1], pc: '#25282d', ec: '#25282d', my: 39.6, mc: '#25282d' },
}[kind];
const petals = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2;
  return [38 + Math.cos(a) * 12, 30 + Math.sin(a) * 12];
});
---
<svg class={`desk ${status}`} viewBox="0 0 120 84" style={`--c:${BODY[kind]}`} role="img" aria-hidden="true">
  <ellipse cx="60" cy="80" rx="52" ry="3" fill="rgba(0,0,0,.18)" />

  <g class="me">
    <!-- 몸 -->
    <rect x="22" y="44" width="32" height="26" rx="10" fill="var(--c)" stroke="#25282d" stroke-width="1.2" />
    {kind === 'human' && <path d="M36 45 h4 l-1 3 l3 11 l-4 4 l-4 -4 l3 -11 z" fill="#F2D53C" stroke="#25282d" stroke-width=".8" />}
    {acc === 'tie' && <path d="M36 45 h4 l-1 3 l3 11 l-4 4 l-4 -4 l3 -11 z" fill="#e5484d" stroke="#25282d" stroke-width=".8" />}
    {acc === 'bowtie' && <path d="M38 47 l-7 -4 v8 z M38 47 l7 -4 v8 z" fill="#e5484d" stroke="#25282d" stroke-width=".8" />}

    <g class="hd">
      {kind === 'zero' && (
        <>
          <rect x="47" y="6" width="5" height="10" rx="1.6" fill="#F2D53C" stroke="#25282d" stroke-width="1" transform="rotate(32 49.5 11)" />
          <circle cx="38" cy="30" r="14.5" fill="#F2D53C" stroke="#25282d" stroke-width="1.2" />
          <circle cx="38" cy="30" r="10.3" fill="#25282d" />
        </>
      )}
      {kind === 'are' && (
        <>
          {petals.map(([x, y]) => <circle cx={x} cy={y} r="5.2" fill="#fff" stroke="#25282d" stroke-width=".9" />)}
          <circle cx="38" cy="30" r="12" fill="#fff" />
          <ellipse cx="23" cy="32" rx="5" ry="2.6" fill="#F4CDBB" stroke="#25282d" stroke-width=".7" transform="rotate(-20 23 32)" />
          <ellipse cx="53" cy="32" rx="5" ry="2.6" fill="#F4CDBB" stroke="#25282d" stroke-width=".7" transform="rotate(20 53 32)" />
          <ellipse cx="38" cy="31" rx="9.5" ry="8.6" fill="#FBE7DA" />
          <circle cx="32" cy="33" r="1.7" fill="#F6B7AE" /><circle cx="44" cy="33" r="1.7" fill="#F6B7AE" />
        </>
      )}
      {kind === 'human' && (
        <>
          <circle cx="38" cy="30" r="12.5" fill="#f2d3b1" stroke="#25282d" stroke-width="1.2" />
          <path d="M25.6 28 c0 -10 6 -14 12.4 -14 s12.4 4 12.4 14 c-3 -5 -7 -7 -12 -7 c-3 2 -8 3 -12.8 7z" fill="#2b2118" />
        </>
      )}
      {kind === 'bull' && (
        <>
          <path d="M27 21 C21 19 19 13 21 9 c2 5 6 7 10 7 M49 21 c6 -2 8 -8 6 -12 c-2 5 -6 7 -10 7" fill="#e9e2d0" stroke="#25282d" stroke-width="1" stroke-linejoin="round" />
          <circle cx="38" cy="30" r="14" fill="#8b5cf6" stroke="#25282d" stroke-width="1.2" />
          <ellipse cx="38" cy="36" rx="7.5" ry="5.2" fill="#ddd0fb" stroke="#25282d" stroke-width=".8" />
          <circle cx="35.6" cy="36" r=".9" fill="#25282d" /><circle cx="40.4" cy="36" r=".9" fill="#25282d" />
        </>
      )}

      <!-- 표정: 일하는 중=집중 / 확인 대기=갸웃 / 마침=웃음 -->
      <g class="face">
        {kind === 'bull' && status !== 'done' && <><circle cx={F.xs[0]} cy={F.ey} r="2.3" fill="#fff" /><circle cx={F.xs[1]} cy={F.ey} r="2.3" fill="#fff" /></>}
        {status === 'done' ? (
          <path d={`M${F.xs[0] - 1.8} ${F.ey + 0.8} q1.8 -2.6 3.6 0 M${F.xs[1] - 1.8} ${F.ey + 0.8} q1.8 -2.6 3.6 0`} stroke={F.ec} stroke-width="1.3" fill="none" stroke-linecap="round" />
        ) : (
          <g class="eyes">
            {F.xs.map((x) => (
              <ellipse cx={x + (status === 'working' ? 0.8 : 0)} cy={F.ey + (kind === 'bull' ? 0.3 : 0)} rx={F.er[0]} ry={F.er[1]} fill={F.pc} />
            ))}
          </g>
        )}
        {status === 'working' && <path d={`M${F.xs[0] - 2.2} ${F.ey - 4} l3.4 1.3 M${F.xs[1] + 2.2} ${F.ey - 4} l-3.4 1.3`} stroke={F.ec} stroke-width="1.1" stroke-linecap="round" />}
        {status === 'waiting' && <path d={`M${F.xs[0] - 2} ${F.ey - 4.6} q2 -1.6 4 0 M${F.xs[1] - 2} ${F.ey - 3.4} h4`} stroke={F.ec} stroke-width="1.1" fill="none" stroke-linecap="round" />}
        {status === 'working' && <path d={`M${36.4} ${F.my} h3.2`} stroke={F.mc} stroke-width="1.2" stroke-linecap="round" />}
        {status === 'waiting' && <ellipse cx="38" cy={F.my} rx="1.1" ry="1.3" fill="none" stroke={F.mc} stroke-width="1" />}
        {status === 'done' && <path d={`M35.4 ${F.my - 0.6} q2.6 3.6 5.2 0 z`} fill={F.mc} stroke={F.mc} stroke-width=".8" stroke-linejoin="round" />}
        {status === 'done' && kind !== 'are' && <><circle cx={F.xs[0] - 2.2} cy={F.ey + 3.6} r="1.4" fill="#F6B7AE" opacity=".8" /><circle cx={F.xs[1] + 2.2} cy={F.ey + 3.6} r="1.4" fill="#F6B7AE" opacity=".8" /></>}
      </g>

      <!-- 직원마다 다른 소품 -->
      {acc === 'glasses' && <g fill="none" stroke="#25282d" stroke-width="1.2"><rect x="30.5" y={ey - 3.2} width="7" height="6" rx="1.5" fill="rgba(255,255,255,.25)" /><rect x="38.5" y={ey - 3.2} width="7" height="6" rx="1.5" fill="rgba(255,255,255,.25)" /><path d={`M37.5 ${ey} h1`} /></g>}
      {acc === 'heart' && <path class="float" d="M54 10 c-2 -3 -6 -1 -4 2 l4 4 l4 -4 c2 -3 -2 -5 -4 -2z" fill="#f43f5e" />}
      {acc === 'beret' && <g><ellipse cx="34" cy="17" rx="12" ry="4.5" fill="#e5484d" stroke="#25282d" stroke-width="1" /><rect x="33" y="11" width="2" height="3" rx="1" fill="#25282d" /></g>}
      {acc === 'pencil' && <g transform="rotate(-35 52 22)"><rect x="49" y="14" width="4" height="15" rx="1" fill="#F2D53C" stroke="#25282d" stroke-width=".8" /><path d="M49 29 l2 4 l2 -4 z" fill="#f4b183" stroke="#25282d" stroke-width=".8" /><rect x="49" y="12" width="4" height="3" fill="#f472b6" /></g>}
      {acc === 'cap' && <g><path d="M24 22 a14 11 0 0 1 28 0 z" fill="#ef4444" stroke="#25282d" stroke-width="1" /><path d="M50 21 h9 a2 2 0 0 1 0 3 h-9 z" fill="#ef4444" stroke="#25282d" stroke-width="1" /></g>}
      {acc === 'ribbon' && <g><path d="M24 17 l-6 -4 v8 z M24 17 l6 -4 v8 z" fill="#f472b6" stroke="#25282d" stroke-width=".8" /><circle cx="24" cy="17" r="1.8" fill="#be185d" /></g>}
      {acc === 'headset' && <g fill="none" stroke="#25282d" stroke-width="2"><path d="M23 30 a15 15 0 0 1 30 0" /><rect x="20" y="27" width="5" height="8" rx="2" fill="#41464d" /><rect x="51" y="27" width="5" height="8" rx="2" fill="#41464d" /><path d="M23 35 q2 6 9 6" stroke-width="1.4" /></g>}
      {acc === 'helmet' && <g><path d="M24 22 a14 12 0 0 1 28 0 z" fill="#F59E0B" stroke="#25282d" stroke-width="1" /><rect x="21" y="20.5" width="34" height="3.5" rx="1.5" fill="#F59E0B" stroke="#25282d" stroke-width="1" /><rect x="36.5" y="11" width="3" height="10" fill="#fbbf24" /></g>}
      {acc === 'crown' && <path d="M29 15 l3 -7 l6 5 l6 -5 l3 7 z" fill="#F2D53C" stroke="#25282d" stroke-width="1" stroke-linejoin="round" />}
    </g>

    <!-- 팔 -->
    {status === 'done' && <g><rect x="14" y="26" width="5" height="22" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" transform="rotate(-20 16 48)" /><rect x="57" y="26" width="5" height="22" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" transform="rotate(20 59 48)" /></g>}
    {status !== 'done' && <><rect class="arm l" x="46" y="52" width="14" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /><rect class="arm r" x="46" y="58" width="14" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /></>}
    {status === 'waiting' && <g><rect x="46" y="44" width="9" height="11" rx="2" fill="#fff" stroke="#25282d" stroke-width=".8" /><path d="M46 47 q-4 2 0 5" stroke="#fff" stroke-width="1.5" fill="none" /><path class="steam" d="M49 41 q-2 -3 0 -6 M52 41 q-2 -3 0 -6" stroke="#a3a9b2" stroke-width="1.2" fill="none" /></g>}
  </g>

  <!-- 모니터와 책상 -->
  <rect x="58" y="34" width="40" height="26" rx="3" fill="#15171a" stroke="#5b616b" stroke-width="1.5" />
  <rect class="ln a" x="63" y="40" width="22" height="2.5" rx="1" fill="var(--c)" />
  <rect class="ln b" x="63" y="46" width="28" height="2.5" rx="1" fill="#a3a9b2" />
  <rect class="ln c" x="63" y="52" width="16" height="2.5" rx="1" fill="#a3a9b2" />
  <rect x="75" y="60" width="6" height="6" fill="#5b616b" />
  <rect x="8" y="66" width="104" height="5" rx="2" fill="#8a6f55" />
  <rect x="14" y="71" width="4" height="8" fill="#6b5442" />
  <rect x="102" y="71" width="4" height="8" fill="#6b5442" />
  {prop && <text x="104" y="64" font-size="13" text-anchor="middle">{prop}</text>}

  <!-- 말풍선 -->
  {status === 'working' && (
    <g class="bub"><rect x="66" y="10" width="30" height="16" rx="8" fill="#fff" stroke="#25282d" stroke-width=".8" /><circle class="d1" cx="74" cy="18" r="2" fill="#24272B" /><circle class="d2" cx="81" cy="18" r="2" fill="#24272B" /><circle class="d3" cx="88" cy="18" r="2" fill="#24272B" /></g>
  )}
  {status === 'waiting' && (
    <g class="bub"><rect x="66" y="10" width="22" height="16" rx="8" fill="#F2D53C" stroke="#25282d" stroke-width=".8" /><text x="77" y="22" font-size="12" font-weight="700" text-anchor="middle" fill="#24272B">?</text></g>
  )}
  {status === 'done' && (
    <g class="bub"><circle cx="78" cy="18" r="9" fill="#4ade80" stroke="#25282d" stroke-width=".8" /><path d="M74 18 l3 3 l5 -6" stroke="#15171a" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
  )}
</svg>

<style>
  .desk {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .eyes, .hd, .me, .arm, .ln, .bub, .steam, .float {
    transform-box: fill-box;
  }
  .eyes {
    transform-origin: center;
    animation: blink 4.2s infinite;
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  .working .arm.l { animation: tap 0.35s ease-in-out infinite alternate; }
  .working .arm.r { animation: tap 0.35s ease-in-out infinite alternate-reverse; }
  @keyframes tap {
    from { transform: translate(0, 0); }
    to { transform: translate(2px, -2px); }
  }
  .working .ln { transform-origin: left center; animation: type 1.8s steps(6) infinite; }
  .working .ln.b { animation-delay: 0.6s; }
  .working .ln.c { animation-delay: 1.2s; }
  @keyframes type {
    from { transform: scaleX(0.1); }
    to { transform: scaleX(1); }
  }
  .working .hd { transform-origin: center bottom; animation: nod 1.4s ease-in-out infinite; }
  @keyframes nod {
    50% { transform: translateY(1.5px); }
  }
  .working .d1, .working .d2, .working .d3 { animation: dot 1.2s infinite; }
  .working .d2 { animation-delay: 0.2s; }
  .working .d3 { animation-delay: 0.4s; }
  @keyframes dot {
    0%, 60%, 100% { opacity: 0.25; }
    30% { opacity: 1; }
  }
  .waiting .hd { transform-origin: center bottom; animation: tilt 3s ease-in-out infinite; }
  @keyframes tilt {
    50% { transform: rotate(-8deg); }
  }
  .waiting .arm.l { transform: translate(-6px, -6px); }
  .waiting .steam { animation: steam 2s ease-in-out infinite; }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(2px); }
    50% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-3px); }
  }
  .waiting .bub, .float { animation: bob 2s ease-in-out infinite; }
  @keyframes bob {
    50% { transform: translateY(-2px); }
  }
  .done .me { transform-origin: center bottom; animation: stretch 3.6s ease-in-out infinite; }
  @keyframes stretch {
    50% { transform: translateY(-1.5px); }
  }
  .done .ln { opacity: 0.4; }
  @media (prefers-reduced-motion: reduce) {
    .desk * { animation: none !important; }
  }
</style>
