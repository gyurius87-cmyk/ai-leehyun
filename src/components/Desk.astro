---
// 사무실 직원 한 명: 책상 앞 캐릭터 + 상태별 움직임
// kind: zero(AI 부서, 제로 가족) / are(사업 부서, 아르 가족 양) / bull(주식 부서, 불리 가족 황소)
// acc: 직원마다 다른 소품 (glasses heart beret pencil tie bowtie cap ribbon headset helmet crown)
// status: working(타이핑) / waiting(커피 들고 기다림) / done(기지개 + ✓)
// since: 확인 대기를 시작한 날(YYYY-MM-DD). 화면에서 며칠째인지 세어 data-age 0(하루) / 1(2~3일, 땀) / 2(4일+, 졸고 거미줄)
const { kind = 'zero', acc = '', status = 'done', prop = '', since = '', papers = 0, pose = 'desk' } = Astro.props;
// pose: desk(책상에서 일함) / stand(서류 들고 대표실 앞에 서서 기다림) / away(자리 비움: 빈 의자와 꺼진 모니터)
const stand = pose === 'stand', away = pose === 'away';
// papers: 대표 책상에 쌓을 서류 장수 (확인할 건수)
const BODY = { zero: '#F2D53C', are: '#9cc3f0', bull: '#a78bfa', human: '#26282e', sec: '#2dd4bf' };
const ey = kind === 'bull' ? 27 : 29;
// 얼굴 위치와 색 (눈 x, 눈 y, 눈 크기, 눈동자 색, 눈썹/감은 눈 색, 입 y, 입 색)
const F = {
  zero: { xs: [34.6, 41.4], ey, er: [1.6, 2.5], pc: '#F2D53C', ec: '#F2D53C', my: 34.8, mc: '#F2D53C' },
  are: { xs: [34.3, 41.7], ey, er: [1.4, 1.4], pc: '#4A4A57', ec: '#4A4A57', my: 34, mc: '#4A4A57' },
  sec: { xs: [34.6, 41.4], ey: 30, er: [1.2, 1.5], pc: '#25282d', ec: '#25282d', my: 35, mc: '#be123c' },
  human: { xs: [34, 42], ey: 30.6, er: [1.3, 1.1], pc: '#25282d', ec: '#25282d', my: 36.2, mc: '#c26a6a' },
  bull: { xs: [33.5, 42.5], ey, er: [1.1, 1.1], pc: '#25282d', ec: '#25282d', my: 39.6, mc: '#25282d' },
}[kind];
const petals = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return [38 + Math.cos(a) * 12.5, 30 + Math.sin(a) * 12.5];
});
---
<svg class={`desk ${status} ${pose}`} data-since={status === 'waiting' && since ? since : undefined} viewBox={stand ? '10 0 62 96' : '0 0 120 84'} style={`--c:${BODY[kind]}`} role="img" aria-hidden="true">
  {stand ? <ellipse cx="38" cy="92" rx="18" ry="2.6" fill="rgba(0,0,0,.25)" /> : <ellipse cx="60" cy="80" rx="52" ry="3" fill="rgba(0,0,0,.18)" />}
  {away && (
    <g class="chair"><rect x="22" y="38" width="30" height="30" rx="8" fill="#4b5563" stroke="#25282d" stroke-width="1.1" /><rect x="20" y="62" width="34" height="6" rx="3" fill="#374151" stroke="#25282d" stroke-width=".9" /><rect x="35" y="68" width="4" height="10" fill="#374151" /></g>
  )}
  {stand && (
    <g class="legs"><rect x="29" y="68" width="7" height="20" rx="2" fill="#2b2f36" stroke="#25282d" stroke-width=".8" /><rect x="40" y="68" width="7" height="20" rx="2" fill="#2b2f36" stroke="#25282d" stroke-width=".8" /><rect x="27" y="86" width="10" height="4" rx="2" fill="#15171a" /><rect x="39" y="86" width="10" height="4" rx="2" fill="#15171a" /></g>
  )}

  {!away && <g class="me">
    <!-- 몸 -->
    <rect x="22" y="44" width="32" height="26" rx="10" fill="var(--c)" stroke="#25282d" stroke-width="1.2" />
    {kind === 'human' && (
      <g>
        <!-- 검은 재킷 + 검은 라운드 티 -->
        <path d="M19.5 70 C19.5 56 24 48.5 32 46 L38 48.5 L44 46 C52 48.5 56.5 56 56.5 70 Z" fill="url(#hmJk)" stroke="#111214" stroke-width="1" stroke-linejoin="round" />
        <path d="M32.6 45.6 Q38 50.6 43.4 45.6 L42 58 L34 58 Z" fill="#0c0d0f" />
        <path d="M32 46 L36.2 58.5 L33.4 60.5 L30.4 53.5 L31.6 51 Z" fill="#23252b" stroke="#3f434c" stroke-width=".7" stroke-linejoin="round" />
        <path d="M44 46 L39.8 58.5 L42.6 60.5 L45.6 53.5 L44.4 51 Z" fill="#23252b" stroke="#3f434c" stroke-width=".7" stroke-linejoin="round" />
        <path d="M33.2 46.4 Q38 50.2 42.8 46.4" fill="none" stroke="#2a2c31" stroke-width=".8" />
      </g>
    )}
    {acc === 'tie' && <path d="M36 45 h4 l-1 3 l3 11 l-4 4 l-4 -4 l3 -11 z" fill="#e5484d" stroke="#25282d" stroke-width=".8" />}
    {acc === 'bowtie' && <path d="M38 47 l-7 -4 v8 z M38 47 l7 -4 v8 z" fill="#e5484d" stroke="#25282d" stroke-width=".8" />}

    <g class="hd">
      {kind === 'zero' && (
        <>
          <rect x="47" y="6" width="5" height="10" rx="1.6" fill="#F2D53C" stroke="#25282d" stroke-width="1" transform="rotate(32 49.5 11)" />
          <circle cx="38" cy="30" r="14.5" fill="#F2D53C" stroke="#25282d" stroke-width="1.2" />
          <circle cx="38" cy="30" r="10.3" fill="#25282d" />
        </>
      )}
      {kind === 'are' && (
        <>
          {petals.map(([x, y]) => <circle cx={x} cy={y} r="4.8" fill="#fff" stroke="#25282d" stroke-width=".9" />)}
          <circle cx="38" cy="30" r="12" fill="#fff" />
          <ellipse cx="23" cy="32" rx="5" ry="2.6" fill="#F4CDBB" stroke="#25282d" stroke-width=".7" transform="rotate(-20 23 32)" />
          <ellipse cx="53" cy="32" rx="5" ry="2.6" fill="#F4CDBB" stroke="#25282d" stroke-width=".7" transform="rotate(20 53 32)" />
          <ellipse cx="38" cy="31" rx="9.5" ry="8.6" fill="#FBE7DA" />
          <circle cx="32" cy="33" r="1.7" fill="#F6B7AE" /><circle cx="44" cy="33" r="1.7" fill="#F6B7AE" />
        </>
      )}
      {kind === 'human' && (
        <>
          <!-- 대표: 사진 참고한 반실사 그림(숱 많은 검은 머리와 눈썹까지 내린 앞머리, 갸름한 얼굴, 홑꺼풀 눈, 옅은 미소, 검은 재킷) -->
          <defs>
            <radialGradient id="hmSkin" cx="40%" cy="42%" r="70%"><stop offset="0" stop-color="#f8e0cd" /><stop offset=".62" stop-color="#efcbb2" /><stop offset="1" stop-color="#d9a98c" /></radialGradient>
            <linearGradient id="hmHair" gradientUnits="userSpaceOnUse" x1="36" y1="11" x2="40" y2="32"><stop offset="0" stop-color="#2b2830" /><stop offset=".45" stop-color="#141317" /><stop offset="1" stop-color="#0b0a0d" /></linearGradient>
            <linearGradient id="hmJk" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2c2e34" /><stop offset=".55" stop-color="#1b1c20" /><stop offset="1" stop-color="#121316" /></linearGradient>
          </defs>
          <path d="M33.6 41 L34 48.6 Q38 50.6 42.4 48.6 L42.6 41 Z" fill="#dcae92" />
          <path d="M34 45.4 Q38 47.8 42.4 45.4" fill="none" stroke="#c99478" stroke-width=".6" opacity=".7" />
          <ellipse cx="50.6" cy="31.6" rx="2.2" ry="3.6" fill="#eec4a9" stroke="#b88568" stroke-width=".6" />
          <path d="M50.4 29.6 q1.2 1.4 .2 3.6" fill="none" stroke="#c48d70" stroke-width=".6" />
          <path d="M27 22.5 L26.8 26.5 C26.8 35 29.8 41.8 35.2 44.8 C37.4 46 39.8 46 42 44.8 C47.6 41.6 50.4 35.4 50.1 26.5 L50 22.5 Z" fill="url(#hmSkin)" stroke="#b7856a" stroke-width=".7" stroke-linejoin="round" />
          <path d="M45.2 39.6 C47.6 37 49 33.6 49.6 29.4 C50 34.4 48.4 40 44 43.2 Z" fill="#d4a184" opacity=".45" />
          <ellipse cx="31.4" cy="35.6" rx="2.4" ry="1.4" fill="#f0a99a" opacity=".14" /><ellipse cx="45.2" cy="35.6" rx="2.2" ry="1.3" fill="#f0a99a" opacity=".14" />
          <path d="M30.6 27.9 q2.4 -.8 4.6 -.1 M41 27.8 q2.4 -.7 4.6 .2" fill="none" stroke="#2a2326" stroke-width="1" stroke-linecap="round" />
          <path d="M31 31 q2.4 -1.5 4.6 .1 q-2.3 1 -4.6 -.1 z" fill="#fff8f2" stroke="#3a2d2a" stroke-width=".5" />
          <path d="M41.2 31 q2.4 -1.6 4.7 0 q-2.3 1.1 -4.7 0 z" fill="#fff8f2" stroke="#3a2d2a" stroke-width=".5" />
          <circle cx="33.5" cy="30.6" r="1.05" fill="#2a1d18" /><circle cx="43.7" cy="30.6" r="1.05" fill="#2a1d18" />
          <circle cx="33.8" cy="30.3" r=".3" fill="#fff" /><circle cx="44" cy="30.3" r=".3" fill="#fff" />
          <path d="M30.8 30.9 q2.5 -1.9 5 .1 M41 30.9 q2.6 -2 5.1 0" fill="none" stroke="#1d1717" stroke-width=".75" stroke-linecap="round" />
          <path d="M31.4 31.5 q2.2 .9 4.2 0 M41.6 31.5 q2.2 .9 4.2 0" fill="none" stroke="#b07f6a" stroke-width=".35" opacity=".8" />
          <path d="M38.8 31.4 C39 33.4 39.8 35 40.2 36.2" fill="none" stroke="#c99478" stroke-width=".7" stroke-linecap="round" />
          <path d="M36.6 36.8 q1.6 1 3.4 .2 q.8 -.6 .6 -1.1" fill="none" stroke="#b9826a" stroke-width=".7" stroke-linecap="round" />
          <path d="M35.2 39.8 q1.8 -.9 3.3 -.3 q1.5 -.6 3.2 .3 q-1.6 1.6 -3.2 1.6 q-1.8 0 -3.3 -1.6 z" fill="#cf8780" />
          <path d="M35.2 39.8 q3.3 .9 6.5 0" fill="none" stroke="#a9615b" stroke-width=".55" stroke-linecap="round" />
          <path d="M25 32 C22.4 21.5 27 13.2 37.4 12.6 C47.4 12 53.4 17.6 52.4 27.6 C52.2 30 51.8 31.6 51.2 32.8 L49.8 28.8 C49 26.4 48 25.4 46 25.2 Q38 24.2 30.6 25.4 C29 27 28.2 29.4 27.6 32.6 Z" fill="url(#hmHair)" />
          <path d="M50.6 20 C52.6 23 52.8 27.6 51.6 32.6 L50.2 29.4 C50 26 49.6 23.6 48.6 21.6 Z" fill="url(#hmHair)" /><path d="M27.4 19 C25.2 23 25 28 26 32.4 L27.6 31.2 C27.6 27 28.2 23.4 29.6 21 Z" fill="url(#hmHair)" />
          <path d="M30.4 17.5 C29.8 21.5 27.5 26.0 28.6 30.4 C30.1 26.4 34.8 21.9 35.2 17.5 Z" fill="url(#hmHair)" /><path d="M33.2 17.5 C32.6 21.5 30.3 23.8 31.4 28.2 C32.9 24.2 37.6 21.9 38.0 17.5 Z" fill="url(#hmHair)" /><path d="M36.0 17.5 C35.4 21.5 33.1 23.2 34.2 27.6 C35.7 23.6 40.4 21.9 40.8 17.5 Z" fill="url(#hmHair)" /><path d="M38.8 17.5 C38.2 21.5 35.9 23.7 37.0 28.1 C38.5 24.1 43.2 21.9 43.6 17.5 Z" fill="url(#hmHair)" /><path d="M41.6 17.5 C41.0 21.5 38.7 23.1 39.8 27.5 C41.3 23.5 46.0 21.9 46.4 17.5 Z" fill="url(#hmHair)" /><path d="M44.4 17.5 C43.8 21.5 41.5 23.5 42.6 27.9 C44.1 23.9 48.8 21.9 49.2 17.5 Z" fill="url(#hmHair)" /><path d="M45.6 17.5 C45.2 21.5 44.3 22.8 45.4 27.2 C46.9 23.2 49.6 21.9 50 17.5 Z" fill="url(#hmHair)" /><path d="M46 17.5 C45.6 21.5 47.1 22.0 48.2 26.4 C49.7 22.4 50 21.9 50.2 17.5 Z" fill="url(#hmHair)" />
          <path d="M32.8 18.5 C32.2 22.5 30.0 25.4 29.1 29.0 M35.6 18.5 C35.0 22.5 32.8 23.2 31.9 26.8 M38.4 18.5 C37.8 22.5 35.6 22.6 34.7 26.2 M41.2 18.5 C40.6 22.5 38.4 23.1 37.5 26.7 M44.0 18.5 C43.4 22.5 41.2 22.5 40.3 26.1 M46.8 18.5 C46.2 22.5 44.0 22.9 43.1 26.5 M49.5 18.5 C48.9 22.5 46.8 22.2 45.9 25.8 M49.5 18.5 C48.9 22.5 49.6 21.4 48.7 25.0" fill="none" stroke="#3c3843" stroke-width=".45" stroke-linecap="round" opacity=".7" />
          <path d="M31 15.8 C36 13.8 43 13.8 48.4 16.8" fill="none" stroke="#6a6574" stroke-width="1.4" stroke-linecap="round" opacity=".32" />
        </>
      )}
      {kind === 'sec' && (
        <>
          <circle cx="38" cy="11" r="5.5" fill="#4a3222" />
          <circle cx="38" cy="30" r="12.5" fill="#f5dcc4" stroke="#25282d" stroke-width="1.2" />
          <path d="M25.6 30 c-1 -11 5 -15.5 12.4 -15.5 s13.4 4.5 12.4 15.5 c-2 -6 -6 -9 -12.4 -9 s-10.4 3 -12.4 9z" fill="#4a3222" />
          <circle cx="32" cy="33.5" r="1.6" fill="#F6B7AE" /><circle cx="44" cy="33.5" r="1.6" fill="#F6B7AE" />
        </>
      )}
      {kind === 'bull' && (
        <>
          <path d="M27 21 C21 19 19 13 21 9 c2 5 6 7 10 7 M49 21 c6 -2 8 -8 6 -12 c-2 5 -6 7 -10 7" fill="#e9e2d0" stroke="#25282d" stroke-width="1" stroke-linejoin="round" />
          <circle cx="38" cy="30" r="14" fill="#8b5cf6" stroke="#25282d" stroke-width="1.2" />
          <ellipse cx="38" cy="36" rx="7.5" ry="5.2" fill="#ddd0fb" stroke="#25282d" stroke-width=".8" />
          <circle cx="35.6" cy="36" r=".9" fill="#25282d" /><circle cx="40.4" cy="36" r=".9" fill="#25282d" />
        </>
      )}

      <!-- 표정: 일하는 중=집중 / 확인 대기=갸웃 / 마침=웃음 -->
      <g class="face" style={kind === 'human' ? 'display:none' : undefined}>
        {kind === 'bull' && status !== 'done' && <><circle cx={F.xs[0]} cy={F.ey} r="2.3" fill="#fff" /><circle cx={F.xs[1]} cy={F.ey} r="2.3" fill="#fff" /></>}
        {status === 'done' ? (
          <path d={`M${F.xs[0] - 1.8} ${F.ey + 0.8} q1.8 -2.6 3.6 0 M${F.xs[1] - 1.8} ${F.ey + 0.8} q1.8 -2.6 3.6 0`} stroke={F.ec} stroke-width="1.3" fill="none" stroke-linecap="round" />
        ) : (
          <g class="eyes">
            {F.xs.map((x) => (
              <ellipse cx={x + (status === 'working' ? 0.8 : 0)} cy={F.ey + (kind === 'bull' ? 0.3 : 0)} rx={F.er[0]} ry={F.er[1]} fill={F.pc} />
            ))}
          </g>
        )}
        {status === 'waiting' && <path class="zz-eyes" d={`M${F.xs[0] - 1.8} ${F.ey} h3.6 M${F.xs[1] - 1.8} ${F.ey} h3.6`} stroke={F.ec} stroke-width="1.3" stroke-linecap="round" />}
        {status === 'working' && <path d={`M${F.xs[0] - 2.2} ${F.ey - 4} l3.4 1.3 M${F.xs[1] + 2.2} ${F.ey - 4} l-3.4 1.3`} stroke={F.ec} stroke-width="1.1" stroke-linecap="round" />}
        {status === 'waiting' && <path d={`M${F.xs[0] - 2} ${F.ey - 4.6} q2 -1.6 4 0 M${F.xs[1] - 2} ${F.ey - 3.4} h4`} stroke={F.ec} stroke-width="1.1" fill="none" stroke-linecap="round" />}
        {status === 'working' && <path d={`M${36.4} ${F.my} h3.2`} stroke={F.mc} stroke-width="1.2" stroke-linecap="round" />}
        {status === 'waiting' && <ellipse cx="38" cy={F.my} rx="1.1" ry="1.3" fill="none" stroke={F.mc} stroke-width="1" />}
        {status === 'done' && <path d={`M35.4 ${F.my - 0.6} q2.6 3.6 5.2 0 z`} fill={F.mc} stroke={F.mc} stroke-width=".8" stroke-linejoin="round" />}
        {status === 'done' && kind !== 'are' && <><circle cx={F.xs[0] - 2.2} cy={F.ey + 3.6} r="1.4" fill="#F6B7AE" opacity=".8" /><circle cx={F.xs[1] + 2.2} cy={F.ey + 3.6} r="1.4" fill="#F6B7AE" opacity=".8" /></>}
      </g>

      {status === 'waiting' && <path class="sweat" d="M52 22 q-2.4 3.6 0 5 q2.4 -1.4 0 -5z" fill="#7dd3fc" stroke="#25282d" stroke-width=".6" />}

      <!-- 직원마다 다른 소품 -->
      {acc === 'glasses' && <g fill="none" stroke="#25282d" stroke-width="1.2"><rect x="30.5" y={ey - 3.2} width="7" height="6" rx="1.5" fill="rgba(255,255,255,.25)" /><rect x="38.5" y={ey - 3.2} width="7" height="6" rx="1.5" fill="rgba(255,255,255,.25)" /><path d={`M37.5 ${ey} h1`} /></g>}
      {acc === 'heart' && <path class="float" d="M54 10 c-2 -3 -6 -1 -4 2 l4 4 l4 -4 c2 -3 -2 -5 -4 -2z" fill="#f43f5e" />}
      {acc === 'beret' && <g><ellipse cx="34" cy="17" rx="12" ry="4.5" fill="#e5484d" stroke="#25282d" stroke-width="1" /><rect x="33" y="11" width="2" height="3" rx="1" fill="#25282d" /></g>}
      {acc === 'pencil' && <g transform="rotate(-35 52 22)"><rect x="49" y="14" width="4" height="15" rx="1" fill="#F2D53C" stroke="#25282d" stroke-width=".8" /><path d="M49 29 l2 4 l2 -4 z" fill="#f4b183" stroke="#25282d" stroke-width=".8" /><rect x="49" y="12" width="4" height="3" fill="#f472b6" /></g>}
      {acc === 'cap' && <g><path d="M24 22 a14 11 0 0 1 28 0 z" fill="#ef4444" stroke="#25282d" stroke-width="1" /><path d="M50 21 h9 a2 2 0 0 1 0 3 h-9 z" fill="#ef4444" stroke="#25282d" stroke-width="1" /></g>}
      {acc === 'ribbon' && <g><path d="M24 17 l-6 -4 v8 z M24 17 l6 -4 v8 z" fill="#f472b6" stroke="#25282d" stroke-width=".8" /><circle cx="24" cy="17" r="1.8" fill="#be185d" /></g>}
      {acc === 'headset' && <g fill="none" stroke="#25282d" stroke-width="2"><path d="M23 30 a15 15 0 0 1 30 0" /><rect x="20" y="27" width="5" height="8" rx="2" fill="#41464d" /><rect x="51" y="27" width="5" height="8" rx="2" fill="#41464d" /><path d="M23 35 q2 6 9 6" stroke-width="1.4" /></g>}
      {acc === 'helmet' && <g><path d="M24 22 a14 12 0 0 1 28 0 z" fill="#F59E0B" stroke="#25282d" stroke-width="1" /><rect x="21" y="20.5" width="34" height="3.5" rx="1.5" fill="#F59E0B" stroke="#25282d" stroke-width="1" /><rect x="36.5" y="11" width="3" height="10" fill="#fbbf24" /></g>}
      {acc === 'crown' && <path d="M29 15 l3 -7 l6 5 l6 -5 l3 7 z" fill="#F2D53C" stroke="#25282d" stroke-width="1" stroke-linejoin="round" />}
    </g>

    <!-- 팔 -->
    {stand && (
      <g class="doc"><rect x="27" y="47" width="22" height="17" rx="1.5" fill="#fff" stroke="#25282d" stroke-width=".9" transform="rotate(-6 38 55)" /><path d="M30 52 h13 M30 55.5 h15 M30 59 h10" stroke="#a3a9b2" stroke-width="1.1" transform="rotate(-6 38 55)" /><rect x="40" y="45" width="6" height="3" rx="1" fill="#ef4444" transform="rotate(-6 38 55)" /><rect x="22" y="54" width="9" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /><rect x="45" y="54" width="9" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /></g>
    )}
    {!stand && status === 'done' && <g><rect x="14" y="26" width="5" height="22" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" transform="rotate(-20 16 48)" /><rect x="57" y="26" width="5" height="22" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" transform="rotate(20 59 48)" /></g>}
    {!stand && status !== 'done' && <><rect class="arm l" x="46" y="52" width="14" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /><rect class="arm r" x="46" y="58" width="14" height="5" rx="2.5" fill="var(--c)" stroke="#25282d" stroke-width="1" /></>}
    {!stand && status !== 'done' && kind === 'human' && <><ellipse class="arm l" cx="60.2" cy="54.5" rx="2.4" ry="2" fill="#efcbb2" stroke="#b7856a" stroke-width=".6" /><ellipse class="arm r" cx="60.2" cy="60.5" rx="2.4" ry="2" fill="#efcbb2" stroke="#b7856a" stroke-width=".6" /></>}
    {!stand && status === 'waiting' && <g><rect x="46" y="44" width="9" height="11" rx="2" fill="#fff" stroke="#25282d" stroke-width=".8" /><path d="M46 47 q-4 2 0 5" stroke="#fff" stroke-width="1.5" fill="none" /><path class="steam" d="M49 41 q-2 -3 0 -6 M52 41 q-2 -3 0 -6" stroke="#a3a9b2" stroke-width="1.2" fill="none" /></g>}
  </g>}

  <!-- 모니터와 책상 -->
  {!stand && (
    <>
      <rect x="58" y="34" width="40" height="26" rx="3" fill="#15171a" stroke="#5b616b" stroke-width="1.5" />
      {away ? (
        <g class="note"><rect x="70" y="39" width="17" height="15" rx="1" fill="#fde68a" transform="rotate(4 78 46)" /><text x="78.5" y="49.5" font-size="6.5" font-weight="700" text-anchor="middle" fill="#7c2d12" transform="rotate(4 78 46)">대표실</text></g>
      ) : (
        <>
          <rect class="ln a" x="63" y="40" width="22" height="2.5" rx="1" fill="var(--c)" />
          <rect class="ln b" x="63" y="46" width="28" height="2.5" rx="1" fill="#a3a9b2" />
          <rect class="ln c" x="63" y="52" width="16" height="2.5" rx="1" fill="#a3a9b2" />
        </>
      )}
      <rect x="75" y="60" width="6" height="6" fill="#5b616b" />
      <rect x="8" y="66" width="104" height="5" rx="2" fill="#8a6f55" />
      <rect x="14" y="71" width="4" height="8" fill="#6b5442" />
      <rect x="102" y="71" width="4" height="8" fill="#6b5442" />
      {prop && <text x="104" y="64" font-size="13" text-anchor="middle">{prop}</text>}
    </>
  )}
  {papers > 0 && (
    <g class="papers">
      {Array.from({ length: papers }, (_, i) => (
        <rect x={98.6 + ((i * 37) % 3) - 1} y={63 - i * 3} width="13" height="3" rx=".6" fill={i % 2 ? '#f3f4f6' : '#ffffff'} stroke="#25282d" stroke-width=".6" transform={`rotate(${((i * 53) % 7) - 3} ${105} ${64.5 - i * 3})`} />
      ))}
      <rect x="101" y={63 - (papers - 1) * 3 - 2.4} width="6" height="2.4" rx="1" fill="#ef4444" />
    </g>
  )}

  <!-- 말풍선 -->
  {status === 'working' && (
    <g class="bub"><rect x="66" y="10" width="30" height="16" rx="8" fill="#fff" stroke="#25282d" stroke-width=".8" /><circle class="d1" cx="74" cy="18" r="2" fill="#24272B" /><circle class="d2" cx="81" cy="18" r="2" fill="#24272B" /><circle class="d3" cx="88" cy="18" r="2" fill="#24272B" /></g>
  )}
  {status === 'waiting' && stand && (
    <>
      <g class="bub"><rect class="bub-bg" x="46" y="2" width="24" height="14" rx="7" fill="#F2D53C" stroke="#25282d" stroke-width=".8" /><text class="age-txt" x="58" y="12.6" font-size="10" font-weight="700" text-anchor="middle" fill="#24272B">?</text></g>
      <text class="zzz" x="14" y="16" font-size="9" font-weight="700" fill="#a3a9b2">z<tspan dy="-4" font-size="11">Z</tspan></text>
    </>
  )}
  {status === 'waiting' && !stand && !away && (
    <>
      <g class="bub"><rect class="bub-bg" x="66" y="10" width="26" height="16" rx="8" fill="#F2D53C" stroke="#25282d" stroke-width=".8" /><text class="age-txt" x="79" y="22" font-size="11" font-weight="700" text-anchor="middle" fill="#24272B">?</text></g>
      <g class="web" fill="none" stroke="#cbd5e1" stroke-width=".6" opacity=".8"><path d="M98 34 l-12 0 M98 34 l0 12 M98 34 l-9 9 M90 34 q2 2 0 0 M86 34 q4 4 0 0" /><path d="M92 34 q0 6 6 6 M88 34 q0 10 10 10" /></g>
      <text class="zzz" x="18" y="16" font-size="9" font-weight="700" fill="#a3a9b2">z<tspan dy="-4" font-size="11">Z</tspan></text>
    </>
  )}
  {status === 'done' && (
    <g class="bub"><circle cx="78" cy="18" r="9" fill="#4ade80" stroke="#25282d" stroke-width=".8" /><path d="M74 18 l3 3 l5 -6" stroke="#15171a" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
  )}
</svg>

<style>
  .desk {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .eyes, .hd, .me, .arm, .ln, .bub, .steam, .float, .sweat, .zzz {
    transform-box: fill-box;
  }
  .eyes {
    transform-origin: center;
    animation: blink 4.2s infinite;
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  .working .arm.l { animation: tap 0.35s ease-in-out infinite alternate; }
  .working .arm.r { animation: tap 0.35s ease-in-out infinite alternate-reverse; }
  @keyframes tap {
    from { transform: translate(0, 0); }
    to { transform: translate(2px, -2px); }
  }
  .working .ln { transform-origin: left center; animation: type 1.8s steps(6) infinite; }
  .working .ln.b { animation-delay: 0.6s; }
  .working .ln.c { animation-delay: 1.2s; }
  @keyframes type {
    from { transform: scaleX(0.1); }
    to { transform: scaleX(1); }
  }
  .working .hd { transform-origin: center bottom; animation: nod 1.4s ease-in-out infinite; }
  @keyframes nod {
    50% { transform: translateY(1.5px); }
  }
  .working .d1, .working .d2, .working .d3 { animation: dot 1.2s infinite; }
  .working .d2 { animation-delay: 0.2s; }
  .working .d3 { animation-delay: 0.4s; }
  @keyframes dot {
    0%, 60%, 100% { opacity: 0.25; }
    30% { opacity: 1; }
  }
  .waiting .hd { transform-origin: center bottom; animation: tilt 3s ease-in-out infinite; }
  @keyframes tilt {
    50% { transform: rotate(-8deg); }
  }
  .waiting .arm.l { transform: translate(-6px, -6px); }
  .waiting .steam { animation: steam 2s ease-in-out infinite; }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(2px); }
    50% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-3px); }
  }
  .waiting .bub, .float { animation: bob 2s ease-in-out infinite; }
  @keyframes bob {
    50% { transform: translateY(-2px); }
  }
  /* 확인 대기 기간: 0 하루 이내 / 1 2~3일(주황, 땀) / 2 4일 이상(빨강, 졸고 거미줄) */
  .sweat, .web, .zzz, .zz-eyes { display: none; }
  .waiting[data-age='1'] .bub-bg { fill: #fb923c; }
  .waiting[data-age='1'] .sweat { display: inline; animation: drip 1.6s ease-in infinite; }
  .waiting[data-age='1'] .hd { animation-duration: 1.6s; }
  .waiting[data-age='2'] .bub-bg { fill: #ef4444; }
  .waiting[data-age='2'] .age-txt { fill: #fff; }
  .waiting[data-age='2'] .web, .waiting[data-age='2'] .zzz, .waiting[data-age='2'] .zz-eyes { display: inline; }
  .waiting[data-age='2'] .eyes, .waiting[data-age='2'] .steam { display: none; }
  .waiting[data-age='2'] .hd { animation: doze 3.6s ease-in-out infinite; }
  .waiting[data-age='2'] .zzz { animation: bob 2.4s ease-in-out infinite; }
  .waiting[data-age='2'] .ln { opacity: 0.25; }
  @keyframes drip {
    0% { opacity: 0; transform: translateY(-2px); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(4px); }
  }
  @keyframes doze {
    50% { transform: rotate(10deg) translateY(1px); }
  }
  .done .me { transform-origin: center bottom; animation: stretch 3.6s ease-in-out infinite; }
  @keyframes stretch {
    50% { transform: translateY(-1.5px); }
  }
  .done .ln { opacity: 0.4; }
  .stand .me { transform-origin: center bottom; animation: shift 4s ease-in-out infinite; }
  @keyframes shift { 50% { transform: translateX(1px) rotate(1deg); } }
  @media (prefers-reduced-motion: reduce) {
    .desk * { animation: none !important; }
  }
</style>

<script>
  // 확인 대기 며칠째인지 한국 날짜로 세어 표시 (빌드 뒤에도 날마다 맞게)
  const today = Date.parse(new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10));
  document.querySelectorAll<HTMLElement>('[data-since]').forEach((el) => {
    const days = Math.max(0, Math.round((today - Date.parse(el.dataset.since!)) / 864e5));
    el.dataset.age = days >= 4 ? '2' : days >= 2 ? '1' : '0';
    const t = el.querySelector('.age-txt');
    if (t) t.textContent = days >= 1 ? `${days}일` : '?';
    if (el.classList.contains('stx')) el.textContent = days >= 1 ? `대표실 앞 ${days}일째` : '대표실 앞 대기';
  });
</script>
