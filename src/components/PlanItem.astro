---
import Icon from './Icon.astro';
import { formatDate } from '../lib/data.js';
const { item, index } = Astro.props;
const no = String(index + 1).padStart(2, '0');
const short = (ymd) => formatDate(ymd).slice(5);
---
<article class={`plan-item ${item.status}`}>
  <div class="mark" aria-hidden="true">
    {item.status === 'done' ? <span class="box checked"><Icon name="check" /></span> : <span class="box" />}
  </div>
  <div class="body">
    <div class="pi-top">
      <span class="no">{no}</span>
      {item.status === 'done' && <span class="badge done">끝냄</span>}
      {item.status === 'doing' && <span class="badge doing">하는 중</span>}
      {item.status === 'todo' && <span class="badge">할 것</span>}
      {item.makesProgram && item.status !== 'done' && <span class="badge ghost">프로그램이 나올 공부</span>}
    </div>
    <h3>{item.title}</h3>
    {item.why && <p class="why">{item.why}</p>}

    {item.status === 'done' && (
      <>
        <div class="when mono">
          {short(item.start)} → {short(item.end)} · {item.days}일 · 총 {item.minutes}분
        </div>
        {item.facts && (
          <dl class="facts">
            {item.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}<small>{f.unit}</small></dd>
              </div>
            ))}
          </dl>
        )}
        <div class="links">
          {item.notes?.map((n) => <a href={`/notes/${n}`}>공부노트 #{n} →</a>)}
          {item.result && <a href={item.result.href}>{item.result.label} →</a>}
        </div>
      </>
    )}
  </div>
</article>

<style>
  .plan-item {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    background: var(--white);
    border-radius: 16px;
    padding: 24px 28px;
  }

  .plan-item.doing {
    box-shadow: inset 0 0 0 2px var(--yellow);
  }

  .box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-top: 2px;
    border: 2px solid #c9cdd3;
    border-radius: 7px;
  }

  .box.checked {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--ink);
  }

  .box :global(svg) {
    width: 18px;
    height: 18px;
  }

  .pi-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .no {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .badge {
    font-size: 12px;
    line-height: 1;
    padding: 6px 9px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--muted);
    font-weight: 500;
  }

  .badge.done {
    background: var(--charcoal);
    color: var(--white);
  }

  .badge.doing {
    background: var(--yellow);
    color: var(--ink);
  }

  .badge.ghost {
    background: transparent;
    border: 1px solid #d3d6db;
  }

  h3 {
    margin: 8px 0 0;
    font-size: 21px;
    line-height: 1.4;
  }

  .why {
    margin: 4px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  .when {
    margin-top: 14px;
    font-size: 14px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 12px 0 0;
  }

  .facts div {
    background: var(--paper);
    border-radius: 12px;
    padding: 12px 14px;
  }

  .facts dt {
    font-size: 13px;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.3;
  }

  .facts small {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
    margin-left: 3px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 10px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  @media (max-width: 760px) {
    .plan-item {
      grid-template-columns: 28px 1fr;
      gap: 12px;
      padding: 18px;
      border-radius: 14px;
    }

    .box {
      width: 24px;
      height: 24px;
    }

    h3 {
      font-size: 17px;
    }

    .why {
      font-size: 14px;
    }

    .when {
      font-size: 12px;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .facts dd {
      font-size: 22px;
    }
  }
</style>
