---
// 공부할 것 전체 지도: 큰 분야 → 세부 분야 → 항목 (끝냄 / 우선 / 대기)
import Icon from './Icon.astro';
import { areas, ytSearch } from '../lib/data.js';

const countOf = (area) => area.groups.reduce((n, g) => n + g.items.length, 0);
const doneOf = (area) => area.groups.reduce((n, g) => n + g.items.filter((i) => i.status === 'done').length, 0);
const total = areas.reduce((n, a) => n + countOf(a), 0);
const LABEL = { done: '끝냄', doing: '하는 중', wait: '대기' };
---
<section class="section map" id="map">
  <h2 class="section-title">전체 공부 지도 <span class="mono count">{total}</span></h2>
  <div class="zero-line note">
    <img src="/assets/zero/zero-found.svg" alt="" width="46" height="40" />
    <span>이미 많은 사람이 AI로 실제로 하고 있는 일만 모았습니다. 체크는 끝낸 공부, 노란 칸은 우선 할 것, 빈 칸은 대기입니다. 영상은 유튜브에서 조회수 높은 순으로 열립니다.</span>
  </div>

  <div class="overview">
    {areas.map((a) => (
      <a class="ov" href={`#${a.id}`}>
        <div class="ov-head">
          <b>{a.area}</b>
          <span class="mono">{countOf(a)}</span>
        </div>
        <ul>
          {a.groups.map((g) => <li>{g.name} <span class="mono">{g.items.length}</span></li>)}
        </ul>
      </a>
    ))}
  </div>

  {areas.map((a) => (
    <details class="area" id={a.id} open>
      <summary>
        <span class="area-name">{a.area}</span>
        <span class="mono area-count">{doneOf(a)}/{countOf(a)}</span>
        <span class="area-desc">{a.desc}</span>
      </summary>
      <div class="groups">
        {a.groups.map((g) => (
          <div class="group">
            <h3>{g.name} <span class="mono">{g.items.length}</span></h3>
            <ul>
              {g.items.map((it) => (
                <li class={it.status}>
                  <span class="cb" aria-label={it.status === 'todo' ? `우선 ${it.priority}` : LABEL[it.status]}>
                    {it.status === 'done' && <Icon name="check" />}
                    {it.status === 'todo' && <span class="mono">{it.priority}</span>}
                  </span>
                  <div class="it">
                    <div class="it-title">
                      {it.title}
                      {it.status === 'todo' && <span class="badge">우선 {it.priority}</span>}
                      {it.status === 'doing' && <span class="badge">하는 중</span>}
                      {it.status === 'done' && <span class="badge">끝냄</span>}
                    </div>
                    <p>{it.what}</p>
                    <div class="meta">
                      {it.tools && it.tools.map((t) => <span class="tool">{t}</span>)}
                      {it.video && <a class="yt" href={it.video.url} target="_blank" rel="noopener">▶ 추천 영상</a>}
                      {it.yt && <a class="yt" href={ytSearch(it.yt)} target="_blank" rel="noopener">▶ 조회수순 영상</a>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
  ))}
</section>

<style>
  .count {
    font-size: 0.8em;
    color: var(--muted);
    font-weight: 500;
    margin-left: 4px;
  }

  .note {
    color: var(--muted);
    margin: -6px 0 20px;
  }

  .overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .ov {
    display: block;
    background: var(--charcoal);
    color: var(--white);
    border-radius: 14px;
    padding: 18px 20px;
    text-decoration: none;
  }

  .ov:hover {
    box-shadow: inset 0 0 0 2px var(--yellow);
  }

  .ov-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .ov-head b {
    font-size: 17px;
  }

  .ov-head .mono {
    font-size: 26px;
    font-weight: 500;
    color: var(--yellow);
  }

  .ov ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid #3a3e44;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--muted-dark);
  }

  .ov li .mono {
    font-size: 12px;
    color: #6f757e;
    margin-left: 2px;
  }

  .area {
    margin-top: 40px;
    scroll-margin-top: 16px;
  }

  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    cursor: pointer;
    list-style: none;
    padding: 12px 0;
    border-bottom: 2px solid var(--charcoal);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '접기';
    margin-left: auto;
    font-size: 13px;
    color: var(--muted);
  }

  .area:not([open]) summary::after {
    content: '펼치기';
  }

  .area-name {
    font-size: 24px;
    font-weight: 700;
  }

  .area-count {
    font-size: 18px;
    font-weight: 500;
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  .area-desc {
    font-size: 15px;
    color: var(--muted);
  }

  .groups {
    columns: 3 300px;
    column-gap: 14px;
    margin-top: 16px;
  }

  .group {
    break-inside: avoid;
    background: var(--white);
    border-radius: 14px;
    padding: 18px 20px 8px;
    margin-bottom: 14px;
  }

  .group h3 {
    margin: 0 0 6px;
    font-size: 16px;
  }

  .group h3 .mono {
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
  }

  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    padding: 12px 0;
  }

  .group li + li {
    border-top: 1px solid var(--line);
  }

  .cb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border: 2px solid #c9cdd3;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
  }

  .done .cb {
    background: var(--yellow);
    border-color: var(--yellow);
  }

  .todo .cb,
  .doing .cb {
    border-color: var(--yellow);
    box-shadow: inset 0 0 0 2px var(--yellow);
  }

  .cb :global(svg) {
    width: 15px;
    height: 15px;
  }

  .it-title {
    font-weight: 500;
    font-size: 15.5px;
    line-height: 1.5;
  }

  .done .it-title {
    color: var(--muted);
  }

  .group p {
    margin: 2px 0 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin-top: 6px;
  }

  .tool {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1;
    padding: 5px 7px;
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
  }

  .yt {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 4px;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .yt:hover {
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  .badge {
    display: inline-block;
    margin-left: 6px;
    font-size: 11px;
    line-height: 1;
    padding: 5px 7px;
    border-radius: 999px;
    vertical-align: 2px;
    background: var(--yellow);
    color: var(--ink);
  }

  .done .badge {
    background: var(--charcoal);
    color: var(--white);
  }

  @media (max-width: 1000px) {
    .overview {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .overview {
      gap: 8px;
    }

    .ov {
      padding: 14px;
    }

    .ov-head b {
      font-size: 15px;
    }

    .ov-head .mono {
      font-size: 20px;
    }

    .ov ul {
      font-size: 12px;
      line-height: 1.75;
    }

    .area-name {
      font-size: 20px;
    }

    .area-desc {
      font-size: 13px;
      width: 100%;
      order: 3;
    }

    .groups {
      columns: 1;
    }

    .group {
      padding: 14px 16px 4px;
    }
  }
</style>
