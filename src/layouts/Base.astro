---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { INSTAGRAM, YOUTUBE } from '../lib/data.js';

const {
  title,
  description = '아무것도 모르던 날부터, 이현님의 비서 제로와 함께 쓰는 AI 공부 기록',
  current = '',
} = Astro.props;

const siteTitle = 'AI이현 · AI 공부, 0에서 시작합니다.';
const fullTitle = title ? `${title} · AI이현` : siteTitle;
const ogImage = new URL('/og.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const menu = [
  { key: 'home', href: '/', label: '홈' },
  { key: 'plan', href: '/plan', label: '공부할 것' },
  { key: 'timeline', href: '/timeline', label: '공부한 것' },
  { key: 'notes', href: '/notes', label: '공부노트' },
  { key: 'programs', href: '/programs', label: '프로그램' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#24272B" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AI이현" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <!-- 홈 화면 앱으로 켤 때만, 한 번: 제로가 커지고 윙크한 뒤 사라짐 -->
    <script is:inline>
      try {
        var sa = matchMedia('(display-mode: standalone)').matches || navigator.standalone;
        if (sa && !sessionStorage.getItem('zs') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('splash');
      } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI이현" />
    <meta property="og:title" content={title ? fullTitle : siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="zsplash" aria-hidden="true">
      <svg viewBox="0 0 120 120"><rect x="86" y="4" width="14" height="24" rx="3" fill="#F2D53C" transform="rotate(35 93 16)"/><circle cx="60" cy="62" r="44" fill="#24272B" stroke="#F2D53C" stroke-width="16"/><ellipse cx="48" cy="58" rx="5.5" ry="8.5" fill="#F2D53C"/><ellipse class="wink" cx="72" cy="58" rx="5.5" ry="8.5" fill="#F2D53C"/><path d="M51 77 Q60 84 69 77" stroke="#F2D53C" stroke-width="4.5" fill="none" stroke-linecap="round"/></svg>
    </div>
    <script is:inline>
      (function () {
        var r = document.documentElement, el = document.getElementById('zsplash');
        if (!r.classList.contains('splash')) return;
        try { sessionStorage.setItem('zs', '1'); } catch (e) {}
        var done = function () { r.classList.remove('splash'); };
        el.addEventListener('animationend', function (e) { if (e.animationName === 'zs-out') done(); });
        setTimeout(done, 2600);
      })();
    </script>
    <header class="top">
      <div class="wrap">
        <div class="top-bar">
          <a class="logo" href="/" aria-label="AI이현 홈">AI<span class="y">이현</span></a>
          <nav class="nav" aria-label="메뉴">
            {menu.map((m) => (
              <a href={m.href} aria-current={current === m.key ? 'page' : undefined}>{m.label}</a>
            ))}
            <a class="insta" href={INSTAGRAM} target="_blank" rel="noopener" aria-label="인스타그램 @ai_leehyun">
              <Icon name="insta" />
            </a>
            <a class="insta sns2" href={YOUTUBE} target="_blank" rel="noopener" aria-label="유튜브 @AI이현">
              <Icon name="yt" />
            </a>
          </nav>
        </div>
        <slot name="head" />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span class="logo">AI<span class="y">이현</span></span>
        <span>기록 정리 · 이현님의 비서 제로</span>
        <span class="sns">
          <a href={INSTAGRAM} target="_blank" rel="noopener"><Icon name="insta" /> @ai_leehyun</a>
          <a href={YOUTUBE} target="_blank" rel="noopener"><Icon name="yt" /> @AI이현</a>
        </span>
      </div>
    </footer>

    <nav class="tabbar" aria-label="메뉴">
      {menu.map((m) => (
        <a href={m.href} aria-current={current === m.key ? 'page' : undefined}>
          <Icon name={m.key} />
          <span>{m.short || m.label}</span>
        </a>
      ))}
    </nav>
    <script>
      // 유튜브 링크의 after:날짜를 방문한 날 기준 4개월 전으로 맞춥니다.
      const d = new Date();
      d.setMonth(d.getMonth() - 4);
      const after = d.toISOString().slice(0, 10);
      document.querySelectorAll<HTMLAnchorElement>('a[data-yt]').forEach((a) => {
        const q = `${a.dataset.yt} after:${after}`;
        a.href = `https://www.youtube.com/results?search_query=${encodeURIComponent(q)}&sp=CAMSAhAB`;
      });
    </script>
    <script is:inline src="/track.js" defer></script>
  </body>
</html>
