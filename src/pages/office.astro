---
import Base from '../layouts/Base.astro';
import Desk from '../components/Desk.astro';
import office from '../../data/office.json';
import quotesData from '../../data/quotes.json';
const QUOTES = quotesData.quotes;
import { formatDate } from '../lib/data.js';

// 공개용 현황. 사업 이름·주소·금액·스레드 링크는 data/office.json 에 넣지 않습니다.
const { depts, projects, updated } = office;
const live = depts.filter((d) => !d.planned);
const planned = depts.filter((d) => d.planned);
const staff = live.flatMap((d) => d.teams);
// 확인 대기 직원은 서류를 들고 대표실 문 밖에 줄을 서요 (오래 기다린 순)
const queue = live.flatMap((d) => d.teams.filter((t) => t.status === 'waiting').map((t) => ({ ...t, kind: d.kind, dept: d.name }))).sort((a, b) => (a.since || '').localeCompare(b.since || ''));
const LAMP = { working: '일하는 중', waiting: '확인 대기', done: '마침' };
const STATES = [
  { k: 'doing', label: '진행 중' },
  { k: 'done', label: '끝낸' },
  { k: 'planned', label: '예정' },
];
const deptName = (id) => depts.find((d) => d.id === id)?.name || '';
const count = (k) => projects.filter((p) => p.state === k).length;
// 한강 뷰 배경: 강 건너 빌딩 실루엣 (고정 난수라 빌드마다 같아요)
const towers = [];
for (let x = 0, i = 1; x < 1200; i++) {
  const w = 26 + ((i * 37) % 30);
  const h = 60 + ((i * 53) % 110) + (x < 170 || x > 1030 ? 160 + ((i * 71) % 200) : 0);
  towers.push({ x, w, h, lit: Array.from({ length: Math.floor(h / 14) }, (_, r) => (i * 7 + r * 3) % 4 === 0 ? r : -1).filter((r) => r >= 0) });
  x += w + 3;
}
---
<Base current="office" title="AI 사무실" description="이현이 만든 AI 부서와 AI 직원들, 지금 하는 일과 앞으로 할 프로젝트를 한눈에 봅니다.">
  <div slot="head" class="page-head">
    <div class="row">
      <h1 class="page-title">이현의 AI 사무실</h1>
      <div class="big-count">{staff.length}<small>명</small></div>
    </div>
  </div>

  <div class="wrap">
    <!-- 1. 부서별 현황판 -->
    <section class="board" aria-labelledby="boardTitle">
      <div class="board-head">
        <h2 id="boardTitle">부서별 현황판</h2>
        <span class="legend">
          <span><i class="lamp working"></i>일하는 중 {staff.filter((s) => s.status === 'working').length}</span>
          <span><i class="lamp waiting"></i>확인 대기 {staff.filter((s) => s.status === 'waiting').length}</span>
          <span><i class="lamp done"></i>마침 {staff.filter((s) => s.status === 'done').length}</span>
        </span>
      </div>

      <div class="scene" id="scene" data-tod="day" data-season="autumn">
        <svg class="sky" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
          <g class="moon"><circle cx="110" cy="70" r="26" fill="#fdf6d8" opacity=".9" /><circle cx="122" cy="62" r="24" fill="#1b2a47" opacity=".55" /></g>
          <g class="sun"><circle cx="1010" cy="80" r="46" fill="#fff3b0" opacity=".35" /><circle cx="1010" cy="80" r="30" fill="#ffe27a" /></g>
          <g class="clouds" fill="#fff"><ellipse cx="300" cy="80" rx="60" ry="16" /><ellipse cx="340" cy="68" rx="34" ry="16" /><ellipse cx="760" cy="120" rx="70" ry="15" /><ellipse cx="800" cy="108" rx="36" ry="15" /></g>
          {[[260, 40], [380, 90], [520, 30], [700, 70], [860, 36], [990, 96], [1110, 50], [200, 130], [1040, 150], [620, 120]].map(([x, y]) => <circle class="star" cx={x} cy={y} r="1.6" fill="#fff" />)}
        </svg>
        <svg class="city" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
          
          {towers.map((t) => (
            <g>
              <rect class="tw" x={t.x} y={600 - t.h} width={t.w} height={t.h} />
              {t.lit.map((r) => <rect x={t.x + 5} y={600 - t.h + 6 + r * 14} width={t.w - 10} height="4" class="win" />)}
            </g>
          ))}
          <path class="tw2" d="M1150 600 V120 L1162 40 L1174 120 V600z" /><rect x="1159" y="140" width="6" height="440" fill="#ffd27a" opacity=".35" /><path d="M0 600 V330 Q50 280 110 300 T200 330 V600z" fill="#1f3b2f" /><rect x="66" y="200" width="7" height="100" fill="#cfd6e0" /><rect x="58" y="226" width="23" height="11" rx="3" fill="#e9eef5" /><circle cx="69.5" cy="194" r="3.5" fill="#ef4444" class="blinky" />
        </svg>
        <div class="bldg">
        <div class="roof-flag" aria-hidden="true"><img src="/assets/zero/zero-basic.svg" alt="" width="34" height="34" /></div>
        <div class="roof"><span class="sign">이현의 AI 사무실</span></div>
        <div class="story lobby">
          <div class="plate"><b>대표실</b><span>꼭대기층</span></div>
          <div class="room-in">
            <div class="bossdesk ceo-desk">
              <div class="glass" aria-hidden="true">
              <svg viewBox="0 0 100 200" preserveAspectRatio="none"><rect class="tw" x="4" y="120" width="18" height="80" /><rect class="tw" x="26" y="96" width="14" height="104" /><rect class="tw" x="44" y="132" width="22" height="68" /><rect class="tw2" x="72" y="70" width="10" height="130" /><rect class="tw" x="84" y="112" width="16" height="88" /><rect class="water" x="0" y="184" width="100" height="16" /></svg>
            </div>
              <Desk kind="human" status="working" papers={staff.filter((t) => t.status === 'waiting').length} />
              <span class="pile">확인할 서류 <b>{staff.filter((t) => t.status === 'waiting').length}</b>건</span>
              <b class="who">대표 이현</b>
              <span class="doing">쇼핑몰 14년 · 전업 투자 · AI 공부 중. 말로 일을 맡겨요</span>
            </div>
            <figure class="tv" id="tv" title="눌러서 다른 명언 보기">
              <div class="tv-screen">
                <div class="tv-top"><span class="tv-on">● 오늘의 명언</span><span class="tv-date" id="tvDate"></span></div>
                <blockquote id="tvText">{QUOTES[0].text}</blockquote>
                <figcaption id="tvWho">{QUOTES[0].who}{QUOTES[0].src && ` · ${QUOTES[0].src}`}</figcaption>
              </div>
              <div class="tv-stand" aria-hidden="true"></div>
            </figure>
          </div>
          <div class="hall">
            <div class="hall-door" aria-hidden="true"><span>대표실</span></div>
            <a class="sec-desk" href="https://claude.ai/artifact/4D8f3GednTiSsY6XJwoLJi" target="_blank" rel="noopener" title="대표 전용: 직원들이 올린 서류 검토하기">
              <Desk kind="sec" acc="headset" status="working" prop="🗂️" />
              <b class="who">비서</b>
              <span class="doing">직원들이 올린 확인 요청과 대표님 할 일을 모아 빠짐없이 챙겨요</span>
              <span class="sec-tag">확인할 서류 검토 보러 가기 ↗</span>
            </a>
            <div class="queue-wrap">
              <span class="hall-label">문 밖 검토 대기 <b>{queue.length}</b>명 · 오래 기다린 순</span>
              <ul class="queue">
                {queue.map((t) => (
                  <li title={`${t.dept} ${t.name}: ${t.doing}`}>
                    <Desk kind={t.kind} acc={t.acc} status="waiting" pose="stand" since={t.since} />
                    <b>{t.name.replace(' 담당', '')}</b>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        {live.map((d) => (
          <div class={`story ${d.id}`}>
            <div class="plate"><b>{d.name}</b><span>{d.teams.length}명</span></div>
            <div class="room-in">
              <div class="bossdesk">
                <Desk kind={d.kind} acc="crown" status="working" prop="📋" />
                <b class="who">부서장 {d.head}</b>
                <span class="doing">{d.about}</span>
              </div>
              <ul class="floor">
                {d.teams.map((t) => (
                  <li class="tile">
                    <Desk kind={d.kind} acc={t.acc} status={t.status} prop={t.prop} since={t.since} pose={t.status === 'waiting' ? 'away' : 'desk'} />
                    <div class="card">
                      <div class="meta"><span class="team-chip">{t.team}</span><i class={`lamp ${t.status}`} title={LAMP[t.status]}></i><span class="stx" data-since={t.since}>{LAMP[t.status]}</span></div>
                      <b class="who">{t.name}</b>
                      <span class="doing">{t.doing}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}


        </div>
        <div class="bank" aria-hidden="true"><span class="tr">🌳</span><span>🚲</span><span class="tr">🌳</span><span class="tr">🌳</span><span class="tr">🌳</span><span>🚶</span><span class="tr">🌳</span></div>
        <div class="fall" aria-hidden="true"></div>
        <div class="river" aria-hidden="true">
          <svg viewBox="0 0 1200 90" preserveAspectRatio="none">
            <rect class="deck" x="0" y="22" width="1200" height="7" />
            {Array.from({ length: 8 }, (_, i) => <path d={`M${i * 150} 29 Q${i * 150 + 75} 70 ${i * 150 + 150} 29`} fill="none" class="arch" stroke-width="5" />)}
            {Array.from({ length: 24 }, (_, i) => <circle class="blight" cx={i * 50 + 25} cy="21" r="2" />)}
            {Array.from({ length: 16 }, (_, i) => <rect class="glint" x={(i * 173) % 1180} y={45 + ((i * 29) % 38)} width={26 + (i % 4) * 10} height="2" rx="1" fill="#ffd27a" opacity=".35" style={`animation-delay:${(i % 5) * 0.6}s`} />)}
          </svg>
        </div>
      </div>
    </section>

    <!-- 2. 숫자 -->
    <div class="stat-grid nums">
      <div class="stat"><div class="label">부서</div><div class="num">{live.length}<small>개 + 공사 중 {planned.length}</small></div></div>
      <div class="stat"><div class="label">끝낸 프로젝트</div><div class="num">{count('done')}<small>개</small></div></div>
      <div class="stat"><div class="label">진행 중</div><div class="num">{count('doing')}<small>개</small></div></div>
      <div class="stat"><div class="label">예정</div><div class="num">{count('planned')}<small>개</small></div></div>
    </div>

    <!-- 3. 프로젝트 지도 -->
    <section class="proj" aria-labelledby="projTitle">
      <h2 id="projTitle" class="sec-title">프로젝트</h2>
      <div class="pfilter" role="group" aria-label="프로젝트 나눠 보기">
        {STATES.map((s, i) => (
          <button type="button" data-f={s.k} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <span>{count(s.k)}</span></button>
        ))}
      </div>
      <ul class="plist" id="projList">
        {projects.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li data-s={p.state} hidden={p.state !== 'doing'}>
              <Tag class={`pcard ${p.dept}`} {...(p.href ? { href: p.href } : {})}>
                <span class="dot"></span>
                <span class="pname">{p.name}{p.href && <span aria-hidden="true"> →</span>}</span>
                <span class="pmeta">{deptName(p.dept)}{p.team && ` · ${p.team}`}</span>
                <span class="pstep">{p.state === 'done' ? `${formatDate(p.start).slice(5)} 시작 · 완성` : p.start ? `${formatDate(p.start).slice(5)} 시작 · ${p.step}` : p.step}</span>
              </Tag>
            </li>
          );
        })}
      </ul>

      <div class="build">
        <h3>🚧 공사 중인 부서</h3>
        <div class="lots">
          {planned.map((d) => (
            <div class="lot">
              <div class="plate"><b>{d.name}</b><span class="soon">공사 중</span></div>
              <p>{d.about}</p>
              <div class="first">첫 할 일 · {d.first}</div>
            </div>
          ))}
        </div>
      </div>
    </section>


  </div>
</Base>

<script>
  // 한강 뷰: 한국 시간으로 낮·해 질 녘·밤, 계절로 강변 나무와 떨어지는 것(꽃잎·낙엽·눈)을 바꿔요
  (function () {
    var sc = document.getElementById('scene');
    if (!sc) return;
    var k = new Date(Date.now() + 9 * 3600e3), h = k.getUTCHours(), m = k.getUTCMonth() + 1;
    var tod = h >= 5 && h < 7 ? 'dawn' : h >= 7 && h < 17 ? 'day' : h >= 17 && h < 19 ? 'dusk' : 'night';
    var season = m >= 3 && m <= 5 ? 'spring' : m >= 6 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
    sc.dataset.tod = tod;
    sc.dataset.season = season;
    var tree = { spring: '🌸', summer: '🌳', autumn: '🍁', winter: '🌲' }[season];
    sc.querySelectorAll('.bank .tr').forEach(function (t) { t.textContent = tree; });
    var bit = { spring: '🌸', autumn: '🍂', winter: '❄' }[season];
    var fall = sc.querySelector('.fall');
    if (bit && fall) {
      for (var i = 0; i < 14; i++) {
        var e = document.createElement('i');
        e.textContent = bit;
        e.style.left = ((i * 37) % 100) + '%';
        e.style.fontSize = 10 + (i % 4) * 3 + 'px';
        e.style.color = '#fff';
        e.style.animationDuration = 18 + (i % 5) * 5 + 's';
        e.style.animationDelay = -((i * 7) % 25) + 's';
        e.style.opacity = '0.8';
        fall.appendChild(e);
      }
    }
  })();
</script>

<script define:vars={{ QUOTES }}>
  // 대표실 TV: 한국 날짜로 하루에 하나씩, 누르면 다음 명언
  (function () {
    var kst = new Date(Date.now() + 9 * 3600e3);
    var day = Math.floor(kst.getTime() / 864e5);
    // 날마다 겹치지 않게: 목록 길이와 서로소인 걸음으로 건너뛰며 고르면 한 바퀴 돌 때까지 반복이 없고, 같은 사람 말이 연달아 나오지 않아요
    var n = QUOTES.length, step = 97;
    var gcd = function (a, b) { return b ? gcd(b, a % b) : a; };
    while (gcd(step, n) !== 1) step++;
    var i = (day * step) % n;
    var tv = document.getElementById('tv');
    var show = function () {
      var q = QUOTES[i];
      document.getElementById('tvText').textContent = q.text;
      document.getElementById('tvWho').textContent = q.who + (q.src ? ' · ' + q.src : '');
    };
    document.getElementById('tvDate').textContent = (kst.getUTCMonth() + 1) + '월 ' + kst.getUTCDate() + '일';
    show();
    tv.addEventListener('click', function () {
      i = (i + 1) % QUOTES.length;
      tv.classList.remove('flip');
      void tv.offsetWidth;
      tv.classList.add('flip');
      show();
    });
  })();
</script>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.proj .pfilter button');
  const items = document.querySelectorAll<HTMLLIElement>('#projList li');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((li) => (li.hidden = li.dataset.s !== b.dataset.f));
    })
  );
</script>

<style>
  .board {
    background: var(--charcoal);
    color: var(--white);
    border-radius: 18px;
    padding: 24px;
    margin-top: -28px;
  }
  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .board-head h2 {
    margin: 0;
    font-size: 20px;
  }
  .legend {
    display: flex;
    gap: 14px;
    font-size: 13px;
    color: var(--muted-dark);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lamp {
    flex: none;
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6b7280;
  }
  .lamp.working {
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.22);
    animation: blink 1.6s ease-in-out infinite;
  }
  .lamp.waiting {
    background: var(--yellow);
  }
  @keyframes blink {
    50% { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp.working { animation: none; }
  }
  .scene {
    position: relative;
    margin: 18px -24px 0;
    padding: 34px 0 0;
    overflow: hidden;
    background: linear-gradient(var(--s1) 0%, var(--s2) 50%, var(--s3) 100%);
    transition: background 1s;
    /* 시간대: 낮 기본값, 스크립트가 한국 시간으로 data-tod 를 바꿔요 */
    --s1: #4f9ae0; --s2: #8cc6f2; --s3: #d8eefa;
    --bld: #8094b5; --bld2: #9aaac6; --win: 0; --rv1: #4a8bd0; --rv2: #2f6aa8; --deck: #7c8aa3; --light: 0;
    --sun: 1; --moon: 0; --star: 0; --cloud: 0.85;
  }
  .scene[data-tod='dawn'] { --s1: #6f86c4; --s2: #f2b8a6; --s3: #fbdcae; --bld: #6c6f95; --bld2: #84819f; --win: 0.25; --rv1: #8a8fc0; --rv2: #5a6798; --deck: #6b7290; --light: 0.4; --sun: 1; --moon: 0; --star: 0.2; --cloud: 0.6; }
  .scene[data-tod='dusk'] { --s1: #2e3f72; --s2: #c46f78; --s3: #f2a65e; --bld: #3a3d62; --bld2: #4b4b70; --win: 0.5; --rv1: #6a5a86; --rv2: #33395f; --deck: #4b4f70; --light: 1; --sun: 1; --moon: 0; --star: 0.3; --cloud: 0.5; }
  .scene[data-tod='night'] { --s1: #0f1c33; --s2: #1b2a47; --s3: #b4697a; --bld: #22314d; --bld2: #2c3e5f; --win: 0.55; --rv1: #24406a; --rv2: #13223d; --deck: #3a4a63; --light: 1; --sun: 0; --moon: 1; --star: 1; --cloud: 0; }
  .scene[data-tod='dawn'] .sun circle, .scene[data-tod='dusk'] .sun circle { transform: translateY(150px); }
  .scene[data-tod='dusk'] .sun circle:last-child { fill: #ff9f5a; }
  .sun { opacity: var(--sun); }
  .moon { opacity: var(--moon); }
  .star { opacity: var(--star); }
  .clouds { opacity: var(--cloud); }
  .scene .tw { fill: var(--bld); }
  .scene .tw2 { fill: var(--bld2); }
  .scene .win { fill: #ffd27a; opacity: var(--win); }
  .deck { fill: var(--deck); }
  .arch { stroke: var(--deck); }
  .blight { fill: #ffd27a; opacity: var(--light); }
  .scene[data-season='spring'] .bank { background: linear-gradient(#5f8f4e, #46703a); }
  .scene[data-season='summer'] .bank { background: linear-gradient(#3f8a3a, #2d6b2a); }
  .scene[data-season='autumn'] .bank { background: linear-gradient(#8a7a3a, #6b5a2c); }
  .scene[data-season='winter'] .bank { background: linear-gradient(#dfe7ee, #b9c6d2); }
  .fall { position: absolute; inset: 0; pointer-events: none; z-index: 3; overflow: hidden; }
  .fall :global(i) { position: absolute; top: -20px; font-style: normal; animation: fall linear infinite; }
  @keyframes fall { to { transform: translate(40px, 2400px) rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .fall { display: none; } }
  .sky {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 300px;
  }
  .star { animation: twinkle 3s ease-in-out infinite; }
  .star:nth-child(2n) { animation-delay: 1.4s; }
  @keyframes twinkle { 50% { opacity: 0.3; } }
  .city {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 118px;
    width: 100%;
    height: 600px;
  }
  .blinky { animation: twinkle 1.4s steps(2) infinite; }
  .bldg {
    position: relative;
    width: 82%;
    margin: 0 auto;
  }
  .bank {
    position: relative;
    height: 28px;
    background: linear-gradient(#3f5a3a, #2f4a2c);
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    font-size: 20px;
    line-height: 1;
  }
  .river {
    position: relative;
    height: 90px;
    background: linear-gradient(var(--rv1), var(--rv2));
  }
  .river svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .glint { animation: glint 3s ease-in-out infinite; }
  @keyframes glint { 50% { opacity: 0.05; transform: translateX(8px); } }
  @media (prefers-reduced-motion: reduce) {
