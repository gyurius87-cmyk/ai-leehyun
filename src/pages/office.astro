---
import Base from '../layouts/Base.astro';
import FollowCta from '../components/FollowCta.astro';
import Desk from '../components/Desk.astro';
import office from '../../data/office.json';
import { formatDate } from '../lib/data.js';

// 공개용 현황. 사업 이름·주소·금액·스레드 링크는 data/office.json 에 넣지 않습니다.
const { depts, projects, updated } = office;
const live = depts.filter((d) => !d.planned);
const planned = depts.filter((d) => d.planned);
const staff = live.flatMap((d) => d.teams);
const LAMP = { working: '일하는 중', waiting: '확인 대기', done: '마침' };
const STATES = [
  { k: 'doing', label: '진행 중' },
  { k: 'done', label: '끝낸' },
  { k: 'planned', label: '예정' },
];
const deptName = (id) => depts.find((d) => d.id === id)?.name || '';
const count = (k) => projects.filter((p) => p.state === k).length;
---
<Base current="office" title="AI 사무실" description="이현이 만든 AI 부서와 AI 직원들, 지금 하는 일과 앞으로 할 프로젝트를 한눈에 봅니다.">
  <div slot="head" class="page-head">
    <div class="row">
      <h1 class="page-title">이현의 AI 사무실</h1>
      <div class="big-count">{staff.length}<small>명</small></div>
    </div>
    <p class="page-desc">대표는 이현, 직원은 AI입니다. 말로 일을 맡기면 부서장이 AI 직원에게 나눠 주고, 직원은 만들고 기록합니다.</p>
  </div>

  <div class="wrap">
    <!-- 1. 부서별 현황판 -->
    <section class="board" aria-labelledby="boardTitle">
      <div class="board-head">
        <h2 id="boardTitle">부서별 현황판</h2>
        <span class="legend">
          <span><i class="lamp working"></i>일하는 중 {staff.filter((s) => s.status === 'working').length}</span>
          <span><i class="lamp waiting"></i>확인 대기 {staff.filter((s) => s.status === 'waiting').length}</span>
          <span><i class="lamp done"></i>마침 {staff.filter((s) => s.status === 'done').length}</span>
        </span>
      </div>

      <div class="bldg">
        <div class="roof-flag" aria-hidden="true"><img src="/assets/zero/zero-basic.svg" alt="" width="34" height="34" /></div>
        <div class="roof"><span class="sign">이현의 AI 사무실</span></div>

        {live.map((d) => (
          <div class={`story ${d.id}`}>
            <div class="plate"><b>{d.name}</b><span>{d.teams.length}명</span></div>
            <div class="room-in">
              <div class="bossdesk">
                <Desk kind={d.kind} acc="crown" status="working" prop="📋" />
                <b class="who">부서장 {d.head}</b>
                <span class="doing">{d.about}</span>
              </div>
              <ul class="floor">
                {d.teams.map((t) => (
                  <li class="tile">
                    <Desk kind={d.kind} acc={t.acc} status={t.status} prop={t.prop} since={t.since} />
                    <div class="card">
                      <div class="meta"><span class="team-chip">{t.team}</span><i class={`lamp ${t.status}`} title={LAMP[t.status]}></i><span class="stx" data-since={t.since}>{LAMP[t.status]}</span></div>
                      <b class="who">{t.name}</b>
                      <span class="doing">{t.doing}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}

        <div class="story plan">
          {planned.map((d) => (
            <div class="lot">
              <div class="plate"><b>{d.name}</b><span class="soon">공사 중</span></div>
              <p>{d.about}</p>
              <div class="first">첫 할 일 · {d.first}</div>
            </div>
          ))}
        </div>

        <div class="story lobby">
          <div class="plate"><b>대표실</b><span>1층</span></div>
          <div class="room-in">
            <div class="bossdesk ceo-desk">
              <Desk kind="human" status="working" prop="☕" />
              <b class="who">대표 이현</b>
              <span class="doing">쇼핑몰 14년 · 전업 투자 · AI 공부 중. 말로 일을 맡겨요</span>
            </div>
            <div class="decor" aria-hidden="true"><span class="plant">🪴</span><span class="sofa">🛋️</span><div class="door"><span>입구</span></div></div>
          </div>
        </div>
        <div class="ground" aria-hidden="true"><span>🌳</span><span>🌷</span><span>🌳</span></div>
      </div>
      <p class="board-foot">{formatDate(updated)} 기준 · 매일 밤 갱신</p>
    </section>

    <!-- 2. 숫자 -->
    <div class="stat-grid nums">
      <div class="stat"><div class="label">부서</div><div class="num">{live.length}<small>개 + 예정 {planned.length}</small></div></div>
      <div class="stat"><div class="label">끝낸 프로젝트</div><div class="num">{count('done')}<small>개</small></div></div>
      <div class="stat"><div class="label">진행 중</div><div class="num">{count('doing')}<small>개</small></div></div>
      <div class="stat"><div class="label">예정</div><div class="num">{count('planned')}<small>개</small></div></div>
    </div>

    <!-- 3. 프로젝트 지도 -->
    <section class="proj" aria-labelledby="projTitle">
      <h2 id="projTitle" class="sec-title">프로젝트</h2>
      <div class="pfilter" role="group" aria-label="프로젝트 나눠 보기">
        {STATES.map((s, i) => (
          <button type="button" data-f={s.k} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <span>{count(s.k)}</span></button>
        ))}
      </div>
      <ul class="plist" id="projList">
        {projects.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li data-s={p.state} hidden={p.state !== 'doing'}>
              <Tag class={`pcard ${p.dept}`} {...(p.href ? { href: p.href } : {})}>
                <span class="dot"></span>
                <span class="pname">{p.name}{p.href && <span aria-hidden="true"> →</span>}</span>
                <span class="pmeta">{deptName(p.dept)}{p.team && ` · ${p.team}`}</span>
                <span class="pstep">{p.state === 'done' ? `${formatDate(p.start).slice(5)} 시작 · 완성` : p.start ? `${formatDate(p.start).slice(5)} 시작 · ${p.step}` : p.step}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- 4. 어떻게 일하나 -->
    <section class="how" aria-labelledby="howTitle">
      <h2 id="howTitle" class="sec-title">이렇게 일해요</h2>
      <ol>
        <li><b>1</b><span>이현이 채팅으로 말로 맡겨요</span></li>
        <li><b>2</b><span>부서장이 맞는 AI 직원에게 나눠요</span></li>
        <li><b>3</b><span>AI 직원이 만들고, 공부한 것에 기록해요</span></li>
      </ol>
    </section>

    <FollowCta />
  </div>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.proj .pfilter button');
  const items = document.querySelectorAll<HTMLLIElement>('#projList li');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((li) => (li.hidden = li.dataset.s !== b.dataset.f));
    })
  );
</script>

<style>
  .board {
    background: var(--charcoal);
    color: var(--white);
    border-radius: 18px;
    padding: 24px;
    margin-top: -28px;
  }
  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .board-head h2 {
    margin: 0;
    font-size: 20px;
  }
  .legend {
    display: flex;
    gap: 14px;
    font-size: 13px;
    color: var(--muted-dark);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lamp {
    flex: none;
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6b7280;
  }
  .lamp.working {
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.22);
    animation: blink 1.6s ease-in-out infinite;
  }
  .lamp.waiting {
    background: var(--yellow);
  }
  @keyframes blink {
    50% { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp.working { animation: none; }
  }
  .bldg {
    position: relative;
    margin-top: 18px;
  }
  .roof-flag {
    position: absolute;
    z-index: 2;
    top: -6px;
    left: 50%;
    transform: translateX(60px);
    width: 2px;
    height: 40px;
    background: #a3a9b2;
  }
  .roof-flag img {
    position: absolute;
    left: 2px;
    top: 0;
    animation: wave 3s ease-in-out infinite;
  }
  @keyframes wave {
    50% { transform: rotate(-8deg); }
  }
  .roof {
    margin-top: 30px;
    height: 64px;
    background: #41464d;
    clip-path: polygon(2% 100%, 98% 100%, 90% 0, 10% 0);
    display: grid;
    place-items: center;
  }
  .sign {
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    padding: 4px 14px;
    border-radius: 6px;
    box-shadow: 0 0 18px rgba(242, 213, 60, 0.45);
  }
  .story {
    position: relative;
    margin: 0 2%;
    padding: 14px 16px 18px;
    border-left: 6px solid #41464d;
    border-right: 6px solid #41464d;
    border-bottom: 10px solid #6b5442;
    background:
      repeating-linear-gradient(90deg, transparent 0 119px, rgba(255, 255, 255, 0.03) 119px 120px),
      var(--wall);
  }
  .story::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  }
  .story.ai { --wall: #39351f; --accent: #F2D53C; }
  .story.company { --wall: #233041; --accent: #60a5fa; }
  .story.stock { --wall: #2e2843; --accent: #a78bfa; }
  .story.lobby { --wall: #30343a; --accent: #e4e6ea; }
  .story.plan {
    --wall: #2a2d31;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    background:
      repeating-linear-gradient(-45deg, rgba(242, 213, 60, 0.07) 0 12px, transparent 12px 24px),
      var(--wall);
  }
  .plate {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 12px;
    border-radius: 6px;
    background: #15171a;
    border: 1px solid var(--accent, #5b616b);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .plate span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted-dark);
  }
  .lot {
    border: 2px dashed rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    padding: 12px;
  }
  .lot p {
    margin: 0 0 6px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted-dark);
  }
  .soon {
    border: 1px solid var(--yellow);
    color: var(--yellow) !important;
    border-radius: 6px;
    padding: 0 6px;
  }
  .first {
    font-size: 13px;
    color: var(--yellow);
  }
  .room-in {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .bossdesk {
    flex: none;
    width: 180px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-right: 14px;
    border-right: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .floor {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px 12px;
  }
  .tile {
    min-width: 0;
  }
  .card {
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(0, 0, 0, 0.28);
    border-radius: 10px;
    padding: 7px 10px 9px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--muted-dark);
  }
  .stx[data-age='1'] { color: #fb923c; font-weight: 700; }
  .stx[data-age='2'] { color: #f87171; font-weight: 700; }
  .team-chip, .stx {
    white-space: nowrap;
  }
  .team-chip {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 0 6px;
    margin-right: auto;
  }
  .who {
    font-size: 14px;
  }
  .doing {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted-dark);
  }
  .lobby .room-in {
    justify-content: space-between;
    align-items: flex-end;
  }
  .ceo-desk {
    border-right: 0;
    width: 220px;
  }
  .decor {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    font-size: 34px;
    line-height: 1;
  }
  .door span {
    display: grid;
    place-items: end center;
    width: 70px;
    height: 100px;
    padding-bottom: 6px;
    border-radius: 8px 8px 0 0;
    background: #6b5442;
    border: 3px solid #41464d;
    border-bottom: 0;
    font-size: 11px;
    color: #f3e8d9;
  }
  .ground {
    height: 26px;
    margin: 0;
    background: #3f5a3a;
    border-radius: 0 0 10px 10px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 6%;
    font-size: 20px;
    line-height: 1;
  }
  @media (max-width: 760px) {
    .room-in {
      flex-direction: column;
    }
    .bossdesk {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      border-right: 0;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.15);
      padding: 0 0 10px;
    }
    .bossdesk :global(svg) {
      width: 110px;
    }
    .bossdesk .doing {
      flex-basis: 100%;
    }
    .floor {
      width: 100%;
      grid-template-columns: 1fr 1fr;
    }
    .story {
      margin: 0;
      padding: 12px 10px 14px;
    }
    .story.plan {
      grid-template-columns: 1fr;
    }
    .lobby .room-in {
      flex-direction: row;
    }
    .ceo-desk {
      width: auto;
      flex: 1;
      border-bottom: 0;
    }
  }
  .board-foot {
    margin: 14px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted-dark);
  }
  .nums {
    margin-top: 20px;
    grid-template-columns: repeat(4, 1fr);
  }
  .sec-title {
    margin: 40px 0 12px;
    font-size: 22px;
  }
  .pfilter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pfilter button {
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid #d5d9de;
    background: var(--white);
    color: inherit;
    cursor: pointer;
  }
  .pfilter button span {
    font-family: var(--mono);
    opacity: 0.6;
    margin-left: 2px;
  }
  .pfilter button[aria-pressed='true'] {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: #fff;
  }
  .plist {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .plist li[hidden] {
    display: none;
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    box-sizing: border-box;
    background: var(--white);
    border-radius: 14px;
    padding: 18px 20px 18px 30px;
    text-decoration: none;
    border: 2px solid transparent;
  }
  a.pcard:hover {
    border-color: var(--charcoal);
  }
  .pcard .dot {
    position: absolute;
    left: 14px;
    top: 26px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .pcard.company .dot { background: #60a5fa; }
  .pcard.stock .dot { background: #a78bfa; }
  .pcard.market .dot,
  .pcard.ebook .dot {
    background: transparent;
    border: 2px dashed var(--muted);
  }
  .pname {
    font-weight: 700;
    font-size: 17px;
  }
  .pmeta {
    font-size: 13px;
    color: var(--muted);
  }
  .pstep {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink);
  }
  .how ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .how {
    margin-bottom: 28px;
  }
  .how li {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--white);
    border-radius: 14px;
    padding: 16px 18px;
    font-size: 15px;
  }
  .how b {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--yellow);
    font-family: var(--mono);
  }
  @media (max-width: 1000px) {
    .plist {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .board {
      padding: 18px 16px;
    }
    .plans,
    .plist,
    .how ol {
      grid-template-columns: 1fr;
    }
    .nums {
      grid-template-columns: repeat(2, 1fr);
      margin-top: 16px;
    }
  }
</style>
