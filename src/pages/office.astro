---
import Base from '../layouts/Base.astro';
import FollowCta from '../components/FollowCta.astro';
import Desk from '../components/Desk.astro';
import office from '../../data/office.json';
import quotesData from '../../data/quotes.json';
const QUOTES = quotesData.quotes;
import { formatDate } from '../lib/data.js';

// 공개용 현황. 사업 이름·주소·금액·스레드 링크는 data/office.json 에 넣지 않습니다.
const { depts, projects, updated } = office;
const live = depts.filter((d) => !d.planned);
const planned = depts.filter((d) => d.planned);
const staff = live.flatMap((d) => d.teams);
const LAMP = { working: '일하는 중', waiting: '확인 대기', done: '마침' };
const STATES = [
  { k: 'doing', label: '진행 중' },
  { k: 'done', label: '끝낸' },
  { k: 'planned', label: '예정' },
];
const deptName = (id) => depts.find((d) => d.id === id)?.name || '';
const count = (k) => projects.filter((p) => p.state === k).length;
// 한강 뷰 배경: 강 건너 빌딩 실루엣 (고정 난수라 빌드마다 같아요)
const towers = [];
for (let x = 0, i = 1; x < 1200; i++) {
  const w = 26 + ((i * 37) % 30);
  const h = 60 + ((i * 53) % 110) + (x < 170 || x > 1030 ? 160 + ((i * 71) % 200) : 0);
  towers.push({ x, w, h, lit: Array.from({ length: Math.floor(h / 14) }, (_, r) => (i * 7 + r * 3) % 4 === 0 ? r : -1).filter((r) => r >= 0) });
  x += w + 3;
}
---
<Base current="office" title="AI 사무실" description="이현이 만든 AI 부서와 AI 직원들, 지금 하는 일과 앞으로 할 프로젝트를 한눈에 봅니다.">
  <div slot="head" class="page-head">
    <div class="row">
      <h1 class="page-title">이현의 AI 사무실</h1>
      <div class="big-count">{staff.length}<small>명</small></div>
    </div>
    <p class="page-desc">대표는 이현, 직원은 AI입니다. 말로 일을 맡기면 부서장이 AI 직원에게 나눠 주고, 직원은 만들고 기록합니다.</p>
  </div>

  <div class="wrap">
    <!-- 1. 부서별 현황판 -->
    <section class="board" aria-labelledby="boardTitle">
      <div class="board-head">
        <h2 id="boardTitle">부서별 현황판</h2>
        <span class="legend">
          <span><i class="lamp working"></i>일하는 중 {staff.filter((s) => s.status === 'working').length}</span>
          <span><i class="lamp waiting"></i>확인 대기 {staff.filter((s) => s.status === 'waiting').length}</span>
          <span><i class="lamp done"></i>마침 {staff.filter((s) => s.status === 'done').length}</span>
        </span>
      </div>

      <div class="scene">
        <svg class="sky" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
          <circle cx="110" cy="70" r="26" fill="#fdf6d8" opacity=".9" />
          <circle cx="122" cy="62" r="24" fill="#1b2a47" opacity=".55" />
          {[[260, 40], [380, 90], [520, 30], [700, 70], [860, 36], [990, 96], [1110, 50], [200, 130], [1040, 150], [620, 120]].map(([x, y]) => <circle class="star" cx={x} cy={y} r="1.6" fill="#fff" />)}
        </svg>
        <svg class="city" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
          
          {towers.map((t) => (
            <g>
              <rect x={t.x} y={600 - t.h} width={t.w} height={t.h} fill="#22314d" />
              {t.lit.map((r) => <rect x={t.x + 5} y={600 - t.h + 6 + r * 14} width={t.w - 10} height="4" fill="#ffd27a" opacity=".55" />)}
            </g>
          ))}
          <path d="M1150 600 V120 L1162 40 L1174 120 V600z" fill="#2c3e5f" /><rect x="1159" y="140" width="6" height="440" fill="#ffd27a" opacity=".35" /><path d="M0 600 V330 Q50 280 110 300 T200 330 V600z" fill="#1f3b2f" /><rect x="66" y="200" width="7" height="100" fill="#cfd6e0" /><rect x="58" y="226" width="23" height="11" rx="3" fill="#e9eef5" /><circle cx="69.5" cy="194" r="3.5" fill="#ef4444" class="blinky" />
        </svg>
        <div class="bldg">
        <div class="roof-flag" aria-hidden="true"><img src="/assets/zero/zero-basic.svg" alt="" width="34" height="34" /></div>
        <div class="roof"><span class="sign">이현의 AI 사무실</span></div>
        <div class="story lobby">
          <div class="plate"><b>대표실</b><span>꼭대기층</span></div>
          <div class="room-in">
            <div class="bossdesk ceo-desk">
              <Desk kind="human" status="working" papers={staff.filter((t) => t.status === 'waiting').length} />
              <span class="pile">확인할 서류 <b>{staff.filter((t) => t.status === 'waiting').length}</b>건</span>
              <b class="who">대표 이현</b>
              <span class="doing">쇼핑몰 14년 · 전업 투자 · AI 공부 중. 말로 일을 맡겨요</span>
            </div>
            <figure class="tv" id="tv" title="눌러서 다른 명언 보기">
              <div class="tv-screen">
                <div class="tv-top"><span class="tv-on">● 오늘의 명언</span><span class="tv-date" id="tvDate"></span></div>
                <blockquote id="tvText">{QUOTES[0].text}</blockquote>
                <figcaption id="tvWho">{QUOTES[0].who}{QUOTES[0].src && ` · ${QUOTES[0].src}`}</figcaption>
              </div>
              <div class="tv-stand" aria-hidden="true"></div>
            </figure>
            <div class="decor" aria-hidden="true"><span class="plant">🪴</span><span class="sofa">🛋️</span><div class="door"><span>엘리베이터</span></div></div>
            <a class="sec-desk" href="https://claude.ai/artifact/4D8f3GednTiSsY6XJwoLJi" target="_blank" rel="noopener" title="대표 전용: 비서가 챙긴 할 일 보기">
              <Desk kind="sec" acc="headset" status="working" prop="🗂️" />
              <b class="who">비서</b>
              <span class="doing">직원들이 올린 확인 요청과 대표님 할 일을 모아 빠짐없이 챙겨요</span>
              <span class="sec-tag">대표 전용 창구 ↗</span>
            </a>
          </div>
        </div>

        {live.map((d) => (
          <div class={`story ${d.id}`}>
            <div class="plate"><b>{d.name}</b><span>{d.teams.length}명</span></div>
            <div class="room-in">
              <div class="bossdesk">
                <Desk kind={d.kind} acc="crown" status="working" prop="📋" />
                <b class="who">부서장 {d.head}</b>
                <span class="doing">{d.about}</span>
              </div>
              <ul class="floor">
                {d.teams.map((t) => (
                  <li class="tile">
                    <Desk kind={d.kind} acc={t.acc} status={t.status} prop={t.prop} since={t.since} />
                    <div class="card">
                      <div class="meta"><span class="team-chip">{t.team}</span><i class={`lamp ${t.status}`} title={LAMP[t.status]}></i><span class="stx" data-since={t.since}>{LAMP[t.status]}</span></div>
                      <b class="who">{t.name}</b>
                      <span class="doing">{t.doing}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}


        </div>
        <div class="bank" aria-hidden="true"><span>🌳</span><span>🚲</span><span>🌷</span><span>🌳</span><span>🌳</span><span>🌷</span><span>🌳</span></div>
        <div class="river" aria-hidden="true">
          <svg viewBox="0 0 1200 90" preserveAspectRatio="none">
            <rect x="0" y="22" width="1200" height="7" fill="#3a4a63" />
            {Array.from({ length: 8 }, (_, i) => <path d={`M${i * 150} 29 Q${i * 150 + 75} 70 ${i * 150 + 150} 29`} fill="none" stroke="#3a4a63" stroke-width="5" />)}
            {Array.from({ length: 24 }, (_, i) => <circle cx={i * 50 + 25} cy="21" r="2" fill="#ffd27a" />)}
            {Array.from({ length: 16 }, (_, i) => <rect class="glint" x={(i * 173) % 1180} y={45 + ((i * 29) % 38)} width={26 + (i % 4) * 10} height="2" rx="1" fill="#ffd27a" opacity=".35" style={`animation-delay:${(i % 5) * 0.6}s`} />)}
          </svg>
        </div>
      </div>
      <p class="board-foot">{formatDate(updated)} 기준 · 매일 밤 갱신</p>
    </section>

    <!-- 2. 숫자 -->
    <div class="stat-grid nums">
      <div class="stat"><div class="label">부서</div><div class="num">{live.length}<small>개 + 공사 중 {planned.length}</small></div></div>
      <div class="stat"><div class="label">끝낸 프로젝트</div><div class="num">{count('done')}<small>개</small></div></div>
      <div class="stat"><div class="label">진행 중</div><div class="num">{count('doing')}<small>개</small></div></div>
      <div class="stat"><div class="label">예정</div><div class="num">{count('planned')}<small>개</small></div></div>
    </div>

    <!-- 3. 프로젝트 지도 -->
    <section class="proj" aria-labelledby="projTitle">
      <h2 id="projTitle" class="sec-title">프로젝트</h2>
      <div class="pfilter" role="group" aria-label="프로젝트 나눠 보기">
        {STATES.map((s, i) => (
          <button type="button" data-f={s.k} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <span>{count(s.k)}</span></button>
        ))}
      </div>
      <ul class="plist" id="projList">
        {projects.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li data-s={p.state} hidden={p.state !== 'doing'}>
              <Tag class={`pcard ${p.dept}`} {...(p.href ? { href: p.href } : {})}>
                <span class="dot"></span>
                <span class="pname">{p.name}{p.href && <span aria-hidden="true"> →</span>}</span>
                <span class="pmeta">{deptName(p.dept)}{p.team && ` · ${p.team}`}</span>
                <span class="pstep">{p.state === 'done' ? `${formatDate(p.start).slice(5)} 시작 · 완성` : p.start ? `${formatDate(p.start).slice(5)} 시작 · ${p.step}` : p.step}</span>
              </Tag>
            </li>
          );
        })}
      </ul>

      <div class="build">
        <h3>🚧 공사 중인 부서</h3>
        <div class="lots">
          {planned.map((d) => (
            <div class="lot">
              <div class="plate"><b>{d.name}</b><span class="soon">공사 중</span></div>
              <p>{d.about}</p>
              <div class="first">첫 할 일 · {d.first}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. 어떻게 일하나 -->
    <section class="how" aria-labelledby="howTitle">
      <h2 id="howTitle" class="sec-title">이렇게 일해요</h2>
      <ol>
        <li><b>1</b><span>이현이 채팅으로 말로 맡겨요</span></li>
        <li><b>2</b><span>부서장이 맞는 AI 직원에게 나눠요</span></li>
        <li><b>3</b><span>AI 직원이 만들고, 공부한 것에 기록해요</span></li>
      </ol>
    </section>

    <FollowCta />
  </div>
</Base>

<script define:vars={{ QUOTES }}>
  // 대표실 TV: 한국 날짜로 하루에 하나씩, 누르면 다음 명언
  (function () {
    var kst = new Date(Date.now() + 9 * 3600e3);
    var day = Math.floor(kst.getTime() / 864e5);
    var i = day % QUOTES.length;
    var tv = document.getElementById('tv');
    var show = function () {
      var q = QUOTES[i];
      document.getElementById('tvText').textContent = q.text;
      document.getElementById('tvWho').textContent = q.who + (q.src ? ' · ' + q.src : '');
    };
    document.getElementById('tvDate').textContent = (kst.getUTCMonth() + 1) + '월 ' + kst.getUTCDate() + '일';
    show();
    tv.addEventListener('click', function () {
      i = (i + 1) % QUOTES.length;
      tv.classList.remove('flip');
      void tv.offsetWidth;
      tv.classList.add('flip');
      show();
    });
  })();
</script>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.proj .pfilter button');
  const items = document.querySelectorAll<HTMLLIElement>('#projList li');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((li) => (li.hidden = li.dataset.s !== b.dataset.f));
    })
  );
</script>

<style>
  .board {
    background: var(--charcoal);
    color: var(--white);
    border-radius: 18px;
    padding: 24px;
    margin-top: -28px;
  }
  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .board-head h2 {
    margin: 0;
    font-size: 20px;
  }
  .legend {
    display: flex;
    gap: 14px;
    font-size: 13px;
    color: var(--muted-dark);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lamp {
    flex: none;
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6b7280;
  }
  .lamp.working {
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.22);
    animation: blink 1.6s ease-in-out infinite;
  }
  .lamp.waiting {
    background: var(--yellow);
  }
  @keyframes blink {
    50% { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp.working { animation: none; }
  }
  .scene {
    position: relative;
    margin: 18px -24px 0;
    padding: 34px 0 0;
    overflow: hidden;
    background: linear-gradient(#0f1c33 0%, #1b2a47 38%, #3d4f7a 66%, #b4697a 86%, #e59866 100%);
  }
  .sky {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 300px;
  }
  .star { animation: twinkle 3s ease-in-out infinite; }
  .star:nth-child(2n) { animation-delay: 1.4s; }
  @keyframes twinkle { 50% { opacity: 0.3; } }
  .city {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 118px;
    width: 100%;
    height: 600px;
  }
  .blinky { animation: twinkle 1.4s steps(2) infinite; }
  .bldg {
    position: relative;
    width: 82%;
    margin: 0 auto;
  }
  .bank {
    position: relative;
    height: 28px;
    background: linear-gradient(#3f5a3a, #2f4a2c);
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    font-size: 20px;
    line-height: 1;
  }
  .river {
    position: relative;
    height: 90px;
    background: linear-gradient(#24406a, #13223d);
  }
  .river svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .glint { animation: glint 3s ease-in-out infinite; }
  @keyframes glint { 50% { opacity: 0.05; transform: translateX(8px); } }
  @media (prefers-reduced-motion: reduce) {
    .star, .blinky, .glint { animation: none; }
  }
  .build {
    margin-top: 18px;
    background: var(--charcoal);
    color: var(--white);
    border-radius: 14px;
    padding: 16px;
    border: 3px dashed rgba(242, 213, 60, 0.45);
    background-image: repeating-linear-gradient(-45deg, rgba(242, 213, 60, 0.06) 0 12px, transparent 12px 24px);
  }
  .build h3 {
    margin: 0 0 10px;
    font-size: 16px;
  }
  .lots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .roof-flag {
    position: absolute;
    z-index: 2;
    top: -6px;
    left: 50%;
    transform: translateX(60px);
    width: 2px;
    height: 40px;
    background: #a3a9b2;
  }
  .roof-flag img {
    position: absolute;
    left: 2px;
    top: 0;
    animation: wave 3s ease-in-out infinite;
  }
  @keyframes wave {
    50% { transform: rotate(-8deg); }
  }
  .roof {
    margin-top: 30px;
    height: 64px;
    background: #41464d;
    clip-path: polygon(2% 100%, 98% 100%, 90% 0, 10% 0);
    display: grid;
    place-items: center;
  }
  .sign {
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    padding: 4px 14px;
    border-radius: 6px;
    box-shadow: 0 0 18px rgba(242, 213, 60, 0.45);
  }
  .story {
    position: relative;
    margin: 0 2%;
    padding: 14px 16px 18px;
    border-left: 6px solid #41464d;
    border-right: 6px solid #41464d;
    border-bottom: 10px solid #6b5442;
    background:
      repeating-linear-gradient(90deg, transparent 0 119px, rgba(255, 255, 255, 0.03) 119px 120px),
      var(--wall);
  }
  .story::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  }
  .story.ai { --wall: #39351f; --accent: #F2D53C; }
  .story.company { --wall: #233041; --accent: #60a5fa; }
  .story.stock { --wall: #2e2843; --accent: #a78bfa; }
  .story.lobby { --wall: #30343a; --accent: #e4e6ea; }
  .plate {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 12px;
    border-radius: 6px;
    background: #15171a;
    border: 1px solid var(--accent, #5b616b);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .plate span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted-dark);
  }
  .lot {
    border: 2px dashed rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    padding: 12px;
  }
  .lot p {
    margin: 0 0 6px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted-dark);
  }
  .soon {
    border: 1px solid var(--yellow);
    color: var(--yellow) !important;
    border-radius: 6px;
    padding: 0 6px;
  }
  .first {
    font-size: 13px;
    color: var(--yellow);
  }
  .room-in {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .bossdesk {
    flex: none;
    width: 180px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-right: 14px;
    border-right: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .floor {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px 12px;
  }
  .tile {
    min-width: 0;
  }
  .card {
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(0, 0, 0, 0.28);
    border-radius: 10px;
    padding: 7px 10px 9px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--muted-dark);
  }
  .stx[data-age='1'] { color: #fb923c; font-weight: 700; }
  .stx[data-age='2'] { color: #f87171; font-weight: 700; }
  .team-chip, .stx {
    white-space: nowrap;
  }
  .team-chip {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 0 6px;
    margin-right: auto;
  }
  .who {
    font-size: 14px;
  }
  .doing {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted-dark);
  }
  .lobby .room-in {
    justify-content: space-between;
    align-items: flex-end;
  }
  .ceo-desk {
    border-right: 0;
    width: 220px;
  }
  .decor {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    font-size: 34px;
    line-height: 1;
  }
  .lobby .room-in {
    gap: 20px;
  }
  .tv {
    flex: 1;
    max-width: 520px;
    margin: 0 auto;
    align-self: center;
    cursor: pointer;
  }
  .tv-screen {
    background: radial-gradient(ellipse at 50% 40%, #1f2937, #0b0d10);
    border: 8px solid #15171a;
    outline: 2px solid #41464d;
    border-radius: 10px;
    padding: 16px 22px 18px;
    box-shadow: 0 0 28px rgba(242, 213, 60, 0.18);
    min-height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .tv-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted-dark);
    margin-bottom: 8px;
  }
  .tv-on {
