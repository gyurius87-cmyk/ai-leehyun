---
import Base from '../layouts/Base.astro';
import { programs, plan, stats } from '../lib/data.js';

// 우선 할 것 중, 끝내면 프로그램이 나올 것
const upcoming = plan.filter((i) => i.makesProgram && (i.status === 'todo' || i.status === 'doing')).sort((a, b) => (a.priority || 99) - (b.priority || 99));
const STATUS = { using: '쓰는 중', making: '만드는 중', resting: '쉬는 중' };
// 태그: 누구나 쓸 수 있는 것 / 곧 공개할 것(지금은 AI이현만 열림) / AI이현만 쓰는 것
const TAGS = { public: '모두 사용', wait: '공개 대기', private: 'AI이현 전용' };
const tagOf = (p) => (p.soon ? 'wait' : p.private ? 'private' : 'public');
const FILTERS = [{ k: 'all', label: '전체' }, ...Object.entries(TAGS).map(([k, label]) => ({ k, label }))].filter((f) => f.k === 'all' || programs.some((p) => tagOf(p) === f.k));
---
<Base current="programs" title="프로그램" description="공부하면서 직접 만들어 실제로 쓰는 프로그램을 모아 둡니다.">
  <div slot="head" class="page-head">
    <div class="row">
      <h1 class="page-title">프로그램</h1>
      <div class="big-count">{stats.programs}<small>개</small></div>
    </div>
    <p class="page-desc">공부하면서 직접 만들어, 실제로 쓰는 프로그램을 모아 둡니다. 무엇을 하는지, 어떤 공부에서 나왔는지 함께 남깁니다.</p>
  </div>

  <div class="wrap">
    <div class="stat-grid" style="--cols: 3">
      <div class="stat"><div class="label">만든 프로그램</div><div class="num">{stats.programs}<small>개</small></div></div>
      <div class="stat"><div class="label">쓰는 중</div><div class="num">{stats.programsUsing}<small>개</small></div></div>
      <div class="stat"><div class="label">만드는 중</div><div class="num">{stats.programsMaking}<small>개</small></div></div>
    </div>

    <div style="margin-top: 32px">
      {programs.length === 0 ? (
        <div class="empty">
          <img src="/assets/zero/zero-waiting.svg" alt="기다리는 제로" width="96" height="96" />
          <p style="margin: 0">아직 놓인 프로그램이 없습니다.<br />공부할 것을 하나씩 끝내면, 그 과정에서 만든 프로그램이 여기에 놓입니다.</p>
        </div>
      ) : (
        <div class="pfilter" role="group" aria-label="프로그램 나눠 보기">
          {FILTERS.map((f, i) => (
            <button type="button" data-f={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <span>{f.k === 'all' ? programs.length : programs.filter((p) => tagOf(p) === f.k).length}</span></button>
          ))}
        </div>
        <div class="note-list" id="programList">
          {programs.map((p) => {
            const Card = p.href ? 'a' : 'div';
            return (
            <Card class={`note-card${p.href ? ' linked' : ''}`} data-tag={tagOf(p)} {...(p.href ? (p.href.startsWith('http') ? { href: p.href, target: '_blank', rel: 'noopener' } : { href: p.href }) : {})}>
              <div class="no">{STATUS[p.status] || ''} <span class={`ptag ${tagOf(p)}`}>{TAGS[tagOf(p)]}</span></div>
              <h3>{p.name}{p.href && <span class="go" aria-hidden="true"> ↗</span>}</h3>
              {p.summary && <p>{p.summary}</p>}
              {p.private && !p.href && <div class="facts">직접 쓰는 중</div>}
              {p.href?.startsWith('https://claude.ai') && <div class="facts">Claude 로그인 후 사용</div>}
              {(p.from || p.note) && (
                <div class="facts">
                  {[p.from && `공부: ${plan.find((i) => i.id === p.from)?.title || p.from}`, p.note && `공부노트 #${p.note}`].filter(Boolean).join(' · ')}
                </div>
              )}
            </Card>
            );
          })}
        </div>
      )}
    </div>

    {upcoming.length > 0 && (
      <section class="section">
        <h2 class="section-title">곧 여기에 놓일 것</h2>
        <div class="soon">
          {upcoming.map((i) => (
            <a class="soon-item" href="/plan">
              <span class="tag">공부할 것</span>
              <b>{i.title}</b>
              <span class="why">{i.what || i.why}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  const bar = document.querySelector('.pfilter');
  bar?.addEventListener('click', (e) => {
    const b = e.target.closest('button[data-f]');
    if (!b) return;
    bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll('#programList .note-card').forEach((c) => {
      c.hidden = b.dataset.f !== 'all' && c.dataset.tag !== b.dataset.f;
    });
  });
</script>

<style>
  .pfilter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .pfilter button {
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid #d5d9de;
    background: var(--white);
    color: inherit;
    cursor: pointer;
  }

  .pfilter button span {
    font-family: var(--mono);
    opacity: 0.6;
    margin-left: 2px;
  }

  .pfilter button[aria-pressed='true'] {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: #fff;
  }

  a.note-card.linked {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  a.note-card.linked:hover h3 .go {
    color: var(--ink);
  }

  .note-card .go {
    font-size: 0.85em;
    opacity: 0.55;
  }

  .ptag {
    display: inline-block;
    margin-left: 6px;
    font-size: 12px;
    font-weight: 700;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--charcoal);
  }

  .ptag.wait {
    background: transparent;
    color: var(--ink, inherit);
    border: 1px dashed currentColor;
    padding: 0 7px;
  }

  .ptag.private {
    background: var(--charcoal);
    color: var(--yellow);
  }

  .note-card[hidden] {
    display: none;
  }

  .open {
    display: inline-block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink, inherit);
    box-shadow: inset 0 -0.4em 0 var(--yellow);
    text-decoration: none;
  }

  .soon {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .soon-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
    border-radius: 14px;
    padding: 20px 22px;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .soon-item:hover {
    border-color: var(--charcoal);
  }

  .soon-item .tag {
    align-self: flex-start;
  }

  .soon-item b {
    font-size: 18px;
  }

  .soon-item .why {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .soon {
      grid-template-columns: 1fr;
    }

    .soon-item b {
      font-size: 16px;
    }
  }
</style>
