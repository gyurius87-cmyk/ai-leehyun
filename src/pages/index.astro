---
import Base from '../layouts/Base.astro';
import DayBlock from '../components/DayBlock.astro';
import NoteCard from '../components/NoteCard.astro';
import DayCount from '../components/DayCount.astro';
import Icon from '../components/Icon.astro';
import { days, notes, stats, plan, nextStudy } from '../lib/data.js';

const latest = days[0];
const recent = notes.slice(0, 3);
// 홈에는 다음 공부를 크게, 나머지는 하는 중 → 할 것 → 끝냄 순서로 4개까지
const order = { doing: 0, todo: 1, done: 2 };
const planPreview = [...plan].filter((i) => i !== nextStudy).sort((a, b) => order[a.status] - order[b.status]).slice(0, 4);
---
<Base current="home">
  <div slot="head" class="hero">
    <h1 class="hero-title">AI 공부, <span class="zero mono">0</span>에서 시작합니다.</h1>
    <p class="hero-sub">
      <img src="/assets/zero/zero-basic.svg" alt="" width="36" height="36" />
      <span>아무것도 모르던 날부터, 이현님의 비서 <b>제로</b>와 함께 쓰는 기록</span>
    </p>
    <dl class="counters">
      <div>
        <dt>일째</dt>
        <dd class="y"><DayCount /></dd>
      </div>
      <div>
        <dt>끝낸 공부</dt>
        <dd>{stats.planDone}<span class="of">/{stats.planTotal}</span></dd>
      </div>
      <div>
        <dt>공부노트</dt>
        <dd>{stats.notes}</dd>
      </div>
      <div>
        <dt>만든 프로그램</dt>
        <dd>{stats.programs}</dd>
      </div>
    </dl>
  </div>

  <div class="wrap">
    <section class="section">
      <h2 class="section-title">공부할 것</h2>
      {nextStudy && (
        <a class="next-study" href="/plan">
          <span class="ns-label">{nextStudy.status === 'doing' ? '지금 공부 중' : '다음 공부'}</span>
          <span class="ns-title"><span class="hl">{nextStudy.title}</span></span>
        </a>
      )}
      <ul class="plan-mini">
        {planPreview.map((i) => (
          <li class={i.status}>
            <span class="pm-box" aria-hidden="true">{i.status === 'done' && <Icon name="check" />}</span>
            <span class="pm-title">{i.title}</span>
            <span class="pm-meta mono">
              {i.status === 'done' ? `${i.minutes}분 · 끝냄` : i.status === 'doing' ? '하는 중' : '할 것'}
            </span>
          </li>
        ))}
      </ul>
      <a class="more" href="/plan">공부할 것 전체 보기 →</a>
    </section>

    <section class="section">
      <h2 class="section-title">공부한 것</h2>
      <div class="home-timeline">
        <div>
          {latest && <DayBlock day={latest} />}
          <a class="more" href="/timeline">공부한 것 전체 보기 →</a>
        </div>
        <aside class="zero-line zero-note">
          <img src="/assets/zero/zero-writing.svg" alt="정리 중인 제로" width="56" height="48" />
          <span>오늘 기록은 이현님의 비서 제로가 정리했습니다.</span>
        </aside>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">최근 공부노트</h2>
      <div class="note-list three">
        {recent.map((note) => <NoteCard note={note} />)}
      </div>
      <a class="more" href="/notes">공부노트 전체 보기 →</a>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 56px 0 64px;
  }

  .hero-title {
    margin: 0;
    font-size: 60px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .zero {
    color: var(--yellow);
    font-weight: 700;
  }

  .hero-sub {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    color: var(--muted-dark);
    font-size: 19px;
    line-height: 1.5;
  }

  .hero-sub img {
    width: 36px;
    height: 36px;
    flex: none;
  }

  .hero-sub b {
    color: var(--white);
    font-weight: 500;
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 200px));
    gap: 16px;
    margin: 48px 0 0;
  }

  .counters div {
    border-top: 1px solid #3a3e44;
    padding-top: 14px;
  }

  .counters dt {
    font-size: 15px;
    color: var(--muted-dark);
  }

  .counters dd {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 52px;
    line-height: 1.1;
  }

  .of {
    font-size: 0.5em;
    color: var(--muted-dark);
    margin-left: 2px;
  }

  .next-study {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    background: var(--charcoal);
    color: var(--white);
    border-radius: 16px;
    padding: 20px 26px;
    text-decoration: none;
  }

  .ns-label {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--yellow);
  }

  .ns-title {
    font-size: 22px;
    font-weight: 700;
  }

  .ns-title .hl {
    box-shadow: inset 0 -0.35em 0 rgba(242, 213, 60, 0.45);
  }

  .plan-mini {
    list-style: none;
    margin: 12px 0 0;
    padding: 6px 26px;
    background: var(--white);
    border-radius: 16px;
  }

  .plan-mini li {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 56px;
  }

  .plan-mini li + li {
    border-top: 1px solid var(--line);
  }

  .pm-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid #c9cdd3;
    border-radius: 6px;
  }

  .done .pm-box {
    background: var(--yellow);
    border-color: var(--yellow);
  }

  .pm-box :global(svg) {
    width: 15px;
    height: 15px;
  }

  .pm-title {
    font-size: 17px;
    line-height: 1.5;
  }

  .done .pm-title {
    color: var(--muted);
  }

  .pm-meta {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .doing .pm-meta {
    color: var(--ink);
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  .home-timeline {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 28px;
    align-items: start;
  }

  .zero-note {
    color: var(--muted);
    padding-top: 12px;
  }

  .zero-note img {
    width: 56px;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 20px 0 32px;
    }

    .hero-title {
      font-size: 34px;
      line-height: 1.3;
    }

    .hero-sub {
      font-size: 15px;
      margin-top: 14px;
      align-items: flex-start;
    }

    .hero-sub img {
      width: 30px;
      height: 30px;
    }

    .counters {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 28px;
    }

    .counters dt {
      font-size: 12px;
    }

    .counters dd {
      font-size: 30px;
    }

    .next-study {
      padding: 16px 18px;
      flex-direction: column;
    }

    .ns-label {
      font-size: 12px;
    }

    .ns-title {
      font-size: 18px;
    }

    .plan-mini {
      padding: 4px 16px;
    }

    .plan-mini li {
      grid-template-columns: 24px 1fr auto;
      gap: 10px;
      min-height: 52px;
    }

    .pm-title {
      font-size: 15px;
    }

    .pm-meta {
      font-size: 11px;
    }

    .home-timeline {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .zero-note {
      order: -1;
      padding-top: 0;
      font-size: 13px;
    }

    .zero-note img {
      width: 40px;
    }
  }
</style>
