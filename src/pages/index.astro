---
import Base from '../layouts/Base.astro';
import DayBlock from '../components/DayBlock.astro';
import NoteCard from '../components/NoteCard.astro';
import DayCount from '../components/DayCount.astro';
import { days, notes, stats } from '../lib/data.js';

const latest = days[0];
const recent = notes.slice(0, 3);
---
<Base current="home">
  <div slot="head" class="hero">
    <h1 class="hero-title">AI 공부, <span class="zero mono">0</span>에서 시작합니다.</h1>
    <p class="hero-sub">
      <img src="/assets/zero/zero-basic.svg" alt="" width="36" height="36" />
      <span>아무것도 모르던 날부터, 이현님의 비서 <b>제로</b>와 함께 쓰는 기록</span>
    </p>
    <dl class="counters">
      <div>
        <dt>일째</dt>
        <dd class="y"><DayCount /></dd>
      </div>
      <div>
        <dt>공부노트</dt>
        <dd>{stats.notes}</dd>
      </div>
      <div>
        <dt>만든 프로그램</dt>
        <dd>{stats.programs}</dd>
      </div>
    </dl>
  </div>

  <div class="wrap">
    <section class="section">
      <h2 class="section-title">공부타임라인</h2>
      <div class="home-timeline">
        <div>
          {latest && <DayBlock day={latest} />}
          <a class="more" href="/timeline">타임라인 전체 보기 →</a>
        </div>
        <aside class="zero-line zero-note">
          <img src="/assets/zero/zero-writing.svg" alt="정리 중인 제로" width="56" height="48" />
          <span>오늘 기록은 이현님의 비서 제로가 정리했습니다.</span>
        </aside>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">최근 공부노트</h2>
      <div class="note-list three">
        {recent.map((note) => <NoteCard note={note} />)}
      </div>
      <a class="more" href="/notes">공부노트 전체 보기 →</a>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 56px 0 64px;
  }

  .hero-title {
    margin: 0;
    font-size: 60px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .zero {
    color: var(--yellow);
    font-weight: 700;
  }

  .hero-sub {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    color: var(--muted-dark);
    font-size: 19px;
    line-height: 1.5;
  }

  .hero-sub img {
    width: 36px;
    height: 36px;
    flex: none;
  }

  .hero-sub b {
    color: var(--white);
    font-weight: 500;
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 220px));
    gap: 16px;
    margin: 48px 0 0;
  }

  .counters div {
    border-top: 1px solid #3a3e44;
    padding-top: 14px;
  }

  .counters dt {
    font-size: 15px;
    color: var(--muted-dark);
  }

  .counters dd {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 52px;
    line-height: 1.1;
  }

  .home-timeline {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 28px;
    align-items: start;
  }

  .zero-note {
    color: var(--muted);
    padding-top: 12px;
  }

  .zero-note img {
    width: 56px;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 20px 0 32px;
    }

    .hero-title {
      font-size: 34px;
      line-height: 1.3;
    }

    .hero-sub {
      font-size: 15px;
      margin-top: 14px;
      align-items: flex-start;
    }

    .hero-sub img {
      width: 30px;
      height: 30px;
    }

    .counters {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 28px;
    }

    .counters dt {
      font-size: 12px;
    }

    .counters dd {
      font-size: 34px;
    }

    .home-timeline {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .zero-note {
      order: -1;
      padding-top: 0;
      font-size: 13px;
    }

    .zero-note img {
      width: 40px;
    }
  }
</style>
