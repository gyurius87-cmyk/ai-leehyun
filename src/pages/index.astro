---
import Base from '../layouts/Base.astro';
import DayBlock from '../components/DayBlock.astro';
import NoteCard from '../components/NoteCard.astro';
import DayCount from '../components/DayCount.astro';
import Icon from '../components/Icon.astro';
import { days, notes, stats, planDoing, planTodo, planDone, nextStudy, YOUTUBE } from '../lib/data.js';

const latest = days[0];
const recent = notes.slice(0, 3);
// 홈에는 다음 공부를 크게, 나머지는 하는 중 → 할 것 → 끝냄 순서로 4개까지
const planPreview = [...planDoing, ...planTodo, ...planDone].filter((i) => i !== nextStudy).slice(0, 4);
---
<Base current="home">
  <div slot="head" class="hero">
    <h1 class="hero-title">AI 공부, <span class="zero mono">0</span>에서 시작합니다.</h1>
    <p class="hero-sub">
      <img src="/assets/zero/zero-basic.svg" alt="" width="36" height="36" />
      <span>아무것도 모르던 날부터, 이현님의 비서 <b>제로</b>와 함께 쓰는 기록</span>
    </p>
    <dl class="counters">
      <div>
        <dt>일째</dt>
        <dd class="y"><DayCount /></dd>
      </div>
      <div>
        <dt>끝낸 공부</dt>
        <dd>{stats.planDone}</dd>
      </div>
      <div>
        <dt>공부노트</dt>
        <dd>{stats.notes}</dd>
      </div>
      <div>
        <dt>만든 프로그램</dt>
        <dd>{stats.programs}</dd>
      </div>
    </dl>
  </div>

  <div class="wrap">
    <section class="section">
      <h2 class="section-title">유튜브 최신 영상</h2>
      <div class="yt-row" id="ytRow" aria-live="polite">
        <p class="yt-empty">영상을 불러오는 중이에요.</p>
      </div>
      <a class="more" href={YOUTUBE} target="_blank" rel="noopener">유튜브 @AI이현 채널 보러가기 →</a>
    </section>

    <section class="section">
      <h2 class="section-title">공부할 것</h2>
      {nextStudy && (
        <a class="next-study" href="/plan">
          <span class="ns-label">{nextStudy.status === 'doing' ? '지금 공부 중' : '다음 공부'}</span>
          <span class="ns-title"><span class="hl">{nextStudy.title}</span></span>
        </a>
      )}
      <ul class="plan-mini">
        {planPreview.map((i) => (
          <li class={i.status}>
            <span class="pm-box" aria-hidden="true">{i.status === 'done' && <Icon name="check" />}</span>
            <span class="pm-title">{i.title}</span>
            <span class="pm-meta mono">
              {i.status === 'done' ? (i.minutes ? `${i.minutes}분 · 끝냄` : '끝냄') : i.status === 'doing' ? '하는 중' : `${i.priority}순위`}
            </span>
          </li>
        ))}
      </ul>
      <a class="more" href="/plan">공부할 것 전체 보기 →</a>
    </section>

    <section class="section">
      <h2 class="section-title">공부한 것</h2>
      <div class="home-timeline">
        <div>
          {latest && <DayBlock day={latest} />}
          <a class="more" href="/timeline">공부한 것 전체 보기 →</a>
        </div>
        <aside class="zero-line zero-note">
          <img src="/assets/zero/zero-writing.svg" alt="정리 중인 제로" width="56" height="48" />
          <span>오늘 기록은 이현님의 비서 제로가 정리했습니다.</span>
        </aside>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">최근 공부노트</h2>
      <div class="note-list three">
        {recent.map((note) => <NoteCard note={note} />)}
      </div>
      <a class="more" href="/notes">공부노트 전체 보기 →</a>
    </section>
  </div>
</Base>

<script>
  // 새 영상부터 한 줄. 누르면 그 자리에서 재생, 영상이 없거나 못 불러오면 채널 링크만 남김
  const row = document.getElementById('ytRow');
  const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const ymd = (p) => (p ? p.slice(0, 10).replaceAll('-', '.') : '');
  if (row) {
    fetch('/api/youtube')
      .then((r) => r.json())
      .then(({ items = [], playlist }) => {
        // 목록을 못 읽으면 채널 업로드 재생목록 플레이어 하나로 대신 (새 영상이 맨 앞)
        if (!items.length) {
          row.innerHTML = playlist
            ? `<div class="yt-card"><div class="yt-thumb"><iframe src="https://www.youtube.com/embed/videoseries?list=${esc(playlist)}" title="AI이현 유튜브 최신 영상" loading="lazy" allow="encrypted-media; picture-in-picture; web-share" allowfullscreen></iframe></div></div>`
            : '<p class="yt-empty">아직 올린 영상이 없어요.</p>';
          return;
        }
        row.innerHTML = items.map((v) => `
          <a class="yt-card${v.short ? ' short' : ''}" href="${esc(v.url)}" data-id="${esc(v.id)}" target="_blank" rel="noopener">
            <div class="yt-thumb"><img src="https://i.ytimg.com/vi/${esc(v.id)}/${v.short ? 'oar2' : 'hqdefault'}.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${esc(v.id)}/hqdefault.jpg'" alt="" loading="lazy" /><span class="yt-play">▶</span></div>
            <p class="yt-title">${esc(v.title)}</p>
            <p class="yt-date">${ymd(v.published)}</p>
          </a>`).join('');
        row.addEventListener('click', (e) => {
          const card = e.target.closest('.yt-card');
          if (!card || e.metaKey || e.ctrlKey) return;
          e.preventDefault();
          const box = card.querySelector('.yt-thumb');
          if (box.querySelector('iframe')) return;
          box.innerHTML = `<iframe src="https://www.youtube.com/embed/${card.dataset.id}?autoplay=1&playsinline=1&loop=1&playlist=${card.dataset.id}" title="${esc(card.querySelector('.yt-title').textContent)}" allow="autoplay; encrypted-media; picture-in-picture; web-share" allowfullscreen></iframe>`;
        });
      })
      .catch(() => { row.innerHTML = '<p class="yt-empty">영상을 불러오지 못했어요. 아래 채널에서 볼 수 있어요.</p>'; });
  }
</script>

<style>
  .yt-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 6px;
  }

  .yt-row :global(.yt-card) {
    flex: none;
    width: 320px;
    max-width: 78%;
    scroll-snap-align: start;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .yt-row :global(.yt-thumb) {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--charcoal);
  }

  .yt-row :global(.yt-card.short) {
    width: 270px;
    max-width: 46%;
  }

  .yt-row :global(.yt-card.short .yt-thumb) {
    aspect-ratio: 9 / 16;
  }

  .yt-row :global(.yt-thumb img),
  .yt-row :global(.yt-thumb iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .yt-row :global(.yt-play) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 36px;
    margin: -18px 0 0 -26px;
    border-radius: 10px;
    background: rgba(21, 23, 26, 0.8);
    display: grid;
    place-items: center;
    color: var(--yellow);
    font-size: 18px;
  }

  .yt-row :global(.yt-title) {
    margin: 8px 2px 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .yt-row :global(.yt-date) {
    margin: 2px 2px 0;
    font-size: 13px;
    color: var(--muted);
    font-family: var(--mono);
  }

  .yt-row :global(.yt-empty) {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .yt-row {
      gap: 12px;
    }
  }

  .hero {
    padding: 56px 0 64px;
  }

  .hero-title {
    margin: 0;
    font-size: 60px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .zero {
    color: var(--yellow);
    font-weight: 700;
  }

  .hero-sub {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    color: var(--muted-dark);
    font-size: 19px;
    line-height: 1.5;
  }

  .hero-sub img {
    width: 36px;
    height: 36px;
    flex: none;
  }

  .hero-sub b {
    color: var(--white);
    font-weight: 500;
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 200px));
    gap: 16px;
    margin: 48px 0 0;
  }

  .counters div {
    border-top: 1px solid #3a3e44;
    padding-top: 14px;
  }

  .counters dt {
    font-size: 15px;
    color: var(--muted-dark);
  }

  .counters dd {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 52px;
    line-height: 1.1;
  }

  .of {
    font-size: 0.5em;
    color: var(--muted-dark);
    margin-left: 2px;
  }

  .next-study {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    background: var(--charcoal);
    color: var(--white);
    border-radius: 16px;
    padding: 20px 26px;
    text-decoration: none;
  }

  .ns-label {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--yellow);
  }

  .ns-title {
    font-size: 22px;
    font-weight: 700;
  }

  .ns-title .hl {
    box-shadow: inset 0 -0.35em 0 rgba(242, 213, 60, 0.45);
  }

  .plan-mini {
    list-style: none;
    margin: 12px 0 0;
    padding: 6px 26px;
    background: var(--white);
    border-radius: 16px;
  }

  .plan-mini li {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 56px;
  }

  .plan-mini li + li {
    border-top: 1px solid var(--line);
  }

  .pm-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid #c9cdd3;
    border-radius: 6px;
  }

  .done .pm-box {
    background: var(--yellow);
    border-color: var(--yellow);
  }

  .pm-box :global(svg) {
    width: 15px;
    height: 15px;
  }

  .pm-title {
    font-size: 17px;
    line-height: 1.5;
  }

  .done .pm-title {
    color: var(--muted);
  }

  .pm-meta {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .doing .pm-meta {
    color: var(--ink);
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  .home-timeline {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 28px;
    align-items: start;
  }

  .zero-note {
    color: var(--muted);
    padding-top: 12px;
  }

  .zero-note img {
    width: 56px;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 20px 0 32px;
    }

    .hero-title {
      font-size: 34px;
      line-height: 1.3;
    }

    .hero-sub {
      font-size: 15px;
      margin-top: 14px;
      align-items: flex-start;
    }

    .hero-sub img {
      width: 30px;
      height: 30px;
    }

    .counters {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 28px;
    }

    .counters dt {
      font-size: 12px;
    }

    .counters dd {
      font-size: 30px;
    }

    .next-study {
      padding: 16px 18px;
      flex-direction: column;
    }

    .ns-label {
      font-size: 12px;
    }

    .ns-title {
      font-size: 18px;
    }

    .plan-mini {
      padding: 4px 16px;
    }

    .plan-mini li {
      grid-template-columns: 24px 1fr auto;
      gap: 10px;
      min-height: 52px;
    }

    .pm-title {
      font-size: 15px;
    }

    .pm-meta {
      font-size: 11px;
    }

    .home-timeline {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .zero-note {
      order: -1;
      padding-top: 0;
      font-size: 13px;
    }

    .zero-note img {
      width: 40px;
    }
  }
</style>
