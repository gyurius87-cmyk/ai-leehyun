---
// 폰 홈 화면 아이콘 페이지. 홈 화면 아이콘으로 열면(?go=1) 바로 그 프로그램으로 넘어가고,
// 그냥 열면 '홈 화면에 추가' 버튼과 방법을 보여 줌.
import { programs } from '../../../lib/data.js';
import { appList, CAT_BG } from '../../../lib/progIcons.js';
export function getStaticPaths() {
  return appList(programs).map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const bg = a.id === 'fav' ? '#15171a' : CAT_BG[a.cat] || '#15171a';
const base = `/a/${a.id}/`;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>{a.name}</title>
  <meta name="theme-color" content={bg} />
  <link rel="manifest" href={`${base}app.webmanifest`} />
  <link rel="icon" href={`${base}icon-192.png`} />
  <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
  <script is:inline define:vars={{ href: a.href, id: a.id }}>
    // 즐겨찾기에서 이현님이 넣어 둔 비공개 바로가기 주소가 있으면 그쪽으로 (이 기기에만 저장됨)
    var L = {}; try { L = JSON.parse(localStorage.getItem('fav-links')) || {}; } catch (e) {}
    if (/[?&]go=1/.test(location.search)) location.replace(L[id] || href);
  </script>
  <style is:global>
    :root { --ink: #15171a; --paper: #eef0f2; --panel: #fff; --muted: #5b616b; --line: #e4e6ea; color-scheme: light; }
    @media (prefers-color-scheme: dark) { :root { --ink: #eef0f2; --paper: #121417; --panel: #1b1e22; --muted: #9aa1ab; --line: #2a2e34; color-scheme: dark; } }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 15px/1.6 'IBM Plex Sans KR', system-ui, sans-serif; }
    .wrap { max-width: 440px; margin: 0 auto; padding: 32px max(16px, env(safe-area-inset-right, 0px)) 40px max(16px, env(safe-area-inset-left, 0px)); display: grid; gap: 16px; text-align: center; }
    .app { display: grid; justify-items: center; gap: 8px; }
    .app img { width: 96px; height: 96px; border-radius: 24px; box-shadow: 0 6px 20px rgba(0,0,0,.18); }
    h1 { font-size: 20px; margin: 0; }
    .btn { display: block; padding: 14px; border-radius: 14px; border: 0; font: 700 16px/1.4 system-ui, sans-serif; font-family: inherit; cursor: pointer; text-decoration: none; }
    .main { background: var(--ink); color: var(--paper); }
    .sub { background: var(--panel); color: var(--ink); border: 1px solid var(--line); }
    .how { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; text-align: left; font-size: 14px; }
    .how b { display: block; margin-bottom: 4px; }
    .how ol { margin: 0; padding-left: 20px; }
    .muted { color: var(--muted); font-size: 13px; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <main class="wrap">
    <div class="app"><img src={`${base}icon-192.png`} alt="" /><h1>{a.name}</h1></div>
    <button class="btn main" id="install" hidden>📲 홈 화면에 추가</button>
    <p class="muted" id="done" hidden>홈 화면에 아이콘이 생겼어요. 이제 그 아이콘으로 바로 열려요.</p>
    <div class="how" id="how">
      <b>홈 화면에 아이콘 만들기</b>
      <ol id="steps">
        <li>오른쪽 위(삼성 인터넷은 아래) <b style="display:inline">⋮ / ≡ 메뉴</b>를 눌러요.</li>
        <li><b style="display:inline">홈 화면에 추가</b>(삼성 인터넷은 <b style="display:inline">현재 페이지 추가 → 홈 화면</b>)를 눌러요.</li>
        <li>바탕화면에 생긴 아이콘을 누르면 이 프로그램이 바로 열려요.</li>
      </ol>
    </div>
    <a class="btn sub" href={a.href}>지금 바로 열기</a>
    <a class="muted" href="/fav">← 프로그램 즐겨찾기</a>
  </main>
  <script is:inline>
    let ev = null;
    const btn = document.getElementById('install');
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); ev = e; btn.hidden = false; });
    btn.addEventListener('click', async () => {
      if (!ev) return; ev.prompt();
      const r = await ev.userChoice.catch(() => null); ev = null; btn.hidden = true;
      if (r && r.outcome === 'accepted') { document.getElementById('done').hidden = false; document.getElementById('how').hidden = true; }
    });
    window.addEventListener('appinstalled', () => { btn.hidden = true; document.getElementById('done').hidden = false; document.getElementById('how').hidden = true; });
    if (/iPhone|iPad/.test(navigator.userAgent)) document.getElementById('steps').innerHTML = '<li>아래 가운데 <b style="display:inline">공유 ⬆︎</b> 버튼을 눌러요.</li><li><b style="display:inline">홈 화면에 추가</b>를 눌러요.</li>';
  </script>
</body>
</html>
