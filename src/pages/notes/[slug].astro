---
import Base from '../../layouts/Base.astro';
import { notes, formatDate, INSTAGRAM } from '../../lib/data.js';

export function getStaticPaths() {
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props;

// 원고 맨 위의 안내 인용문은 페이지 상단 안내 상자로 대신하고,
// ==형광펜== 표시는 옐로 밑줄로 바꿉니다.
const html = (await note.module.compiledContent())
  .replace(/^\s*<blockquote>\s*<p>이 글은 이현님의 비서 제로가[\s\S]*?<\/blockquote>/, '')
  .replace(/==([^=<]+)==/g, '<mark>$1</mark>');
---
<Base current="notes" title={note.title} description={note.summary}>
  <div class="wrap article-wrap">
    <a class="back-top" href="/notes">← 공부노트</a>

    <div class="byline">
      <img src="/assets/zero/zero-basic.svg" alt="" width="44" height="44" />
      <p>이 글은 이현님의 비서 제로가 작성했습니다. 오늘 이현님과 함께 공부한 내용을 바탕으로, 따라 할 수 있는 방법으로 정리했습니다. (Claude 기반)</p>
    </div>

    <div class="meta-row">
      <span class="meta">#{note.no} · D{note.day} · {formatDate(note.date)}</span>
      <div class="tags">{note.tags.map((t) => <span class="tag">#{t}</span>)}</div>
    </div>

    <h1 class="title">{note.title}</h1>
    <p class="summary"><span class="hl">{note.summary}</span></p>

    <div class="facts">
      <div class="stat"><div class="label">걸린 시간</div><div class="num">{note.minutes}<small>분</small></div></div>
      <div class="stat"><div class="label">단계</div><div class="num">{note.steps}<small>단계</small></div></div>
      <div class="stat"><div class="label">도구</div><div class="num tool">{note.tools.join(', ')}</div></div>
    </div>

    <article class="prose" set:html={html} />

    <div class="end">
      <a href="/notes">← 공부노트 목록</a>
      <a href={INSTAGRAM} target="_blank" rel="noopener">인스타그램 @ai_leehyun</a>
    </div>
  </div>
</Base>

<style>
  .article-wrap {
    max-width: calc(760px + var(--gutter) * 2);
    padding-top: 40px;
  }

  .back-top {
    display: none;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--charcoal);
    color: var(--muted-dark);
    border-radius: 14px;
    padding: 18px 22px;
    font-size: 15px;
    line-height: 1.65;
  }

  .byline img {
    width: 44px;
    height: 44px;
    flex: none;
  }

  .byline p {
    margin: 0;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }

  .title {
    margin: 14px 0 0;
    font-size: 44px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .summary {
    margin: 14px 0 0;
    font-size: 19px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 32px;
  }

  .facts .tool {
    font-size: 24px;
    line-height: 1.6;
  }

  .prose {
    margin-top: 40px;
  }

  .prose :global(h2) {
    font-size: 28px;
    line-height: 1.4;
    margin: 56px 0 14px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 18px 22px;
    background: var(--white);
    border-left: 4px solid var(--charcoal);
    border-radius: 0 12px 12px 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(mark) {
    background: none;
    color: inherit;
    box-shadow: inset 0 -0.4em 0 var(--yellow);
  }

  .prose :global(del) {
    color: var(--muted);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    background: var(--white);
    border-radius: 12px;
    overflow: hidden;
    font-size: 16px;
    line-height: 1.6;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--charcoal);
    color: var(--white);
    font-weight: 500;
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(pre) {
    background: var(--charcoal);
    color: var(--white);
    padding: 20px 22px;
    border-radius: 12px;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: keep-all;
  }

  .prose :global(pre code) {
    font-family: inherit;
  }

  .end {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid #d5d8dd;
  }

  .end a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .article-wrap {
      padding-top: 12px;
    }

    .back-top {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-bottom: 8px;
      font-weight: 500;
      text-decoration: none;
    }

    .byline {
      padding: 14px 16px;
      font-size: 13px;
      align-items: flex-start;
    }

    .byline img {
      width: 36px;
      height: 36px;
    }

    .meta-row {
      margin-top: 24px;
    }

    .title {
      font-size: 28px;
    }

    .summary {
      font-size: 16px;
    }

    .facts {
      gap: 8px;
      margin-top: 24px;
    }

    .facts .stat {
      padding: 14px;
    }

    .facts .stat .num {
      font-size: 22px;
    }

    .facts .tool {
      font-size: 16px;
    }

    .prose :global(h2) {
      font-size: 19px;
      margin-top: 40px;
    }

    .prose :global(table) {
      font-size: 14px;
    }

    .prose :global(th),
    .prose :global(td) {
      padding: 10px 12px;
    }

    .prose :global(pre) {
      font-size: 13px;
      padding: 16px;
    }
  }
</style>
